module

public import Mathlib.Order.BooleanSubalgebra
public import Mathlib.Order.CompleteSublattice
public import Mathlib.Order.CompleteBooleanAlgebra

@[expose] public section

/-!
# Complete Boolean subalgebras and arbitrary-join generation

A complete subalgebra is closed under the ambient arbitrary suprema and
infima, as well as complements. Its inclusion is an injective complete
lattice homomorphism. The subalgebra generated by a set is the intersection
of all complete subalgebras containing that set, not its finite Boolean
closure.

This constructs the subalgebra only. No preservation theorem for forcing
extensions or construction of a normal ideal is asserted here.
-/

set_option autoImplicit false

noncomputable section

universe u v

namespace Erdos1172CompleteSubalgebra

/-- A Boolean subalgebra closed under all ambient suprema and infima. -/
structure CompleteSubalgebra (B : Type u) [CompleteBooleanAlgebra B]
    extends CompleteSublattice B where
  compl_mem' {b : B} : b ∈ carrier → bᶜ ∈ carrier

variable {B : Type u} [CompleteBooleanAlgebra B]

instance completeSubalgebraSetLike : SetLike (CompleteSubalgebra B) B where
  coe A := A.carrier
  coe_injective A C h := by
    cases A with
    | mk A _hA =>
      cases C with
      | mk C _hC =>
        have hAC : A = C := SetLike.coe_injective h
        cases hAC
        rfl

instance completeSubalgebraPartialOrder : PartialOrder (CompleteSubalgebra B) :=
  .ofSetLike (CompleteSubalgebra B) B

@[ext] theorem ext {A C : CompleteSubalgebra B} (h : ∀ b, b ∈ A ↔ b ∈ C) : A = C := SetLike.ext h

theorem compl_mem {A : CompleteSubalgebra B} {b : B} (hb : b ∈ A) : bᶜ ∈ A := A.compl_mem' hb

theorem sSup_mem {A : CompleteSubalgebra B} {S : Set B}
    (hS : S ⊆ A) : sSup S ∈ A :=
  A.sSupClosed' hS

@[simp] theorem bot_mem (A : CompleteSubalgebra B) : (⊥ : B) ∈ A :=
  CompleteSublattice.bot_mem (L := A.toCompleteSublattice)

/-- The finite Boolean structure used to equip the same carrier. -/
def toBooleanSubalgebra (A : CompleteSubalgebra B) : BooleanSubalgebra B where
  toSublattice := A.toCompleteSublattice.toSublattice
  compl_mem' := A.compl_mem'
  bot_mem' := bot_mem A

/-- Keep the inherited Boolean operations and add the actual ambient
arbitrary suprema and infima from the complete sublattice. -/
instance subtypeCompleteBooleanAlgebra (A : CompleteSubalgebra B) :
    CompleteBooleanAlgebra A :=
  let c : CompleteLattice A :=
    inferInstanceAs (CompleteLattice A.toCompleteSublattice)
  let b : BooleanAlgebra A :=
    inferInstanceAs (BooleanAlgebra (toBooleanSubalgebra A))
  { b with
    sSup := c.sSup
    sInf := c.sInf
    isLUB_sSup := c.isLUB_sSup
    isGLB_sInf := c.isGLB_sInf }

instance subtypeNontrivial (A : CompleteSubalgebra B) [Nontrivial B] :
    Nontrivial A := by
  refine ⟨⟨⊥, ⊤, ?_⟩⟩
  intro h
  exact (bot_ne_top : (⊥ : B) ≠ ⊤)
    (congrArg (fun a : A => (a : B)) h)

/-- The inclusion preserves arbitrary suprema and infima, including empty ones. -/
def inclusion (A : CompleteSubalgebra B) : CompleteLatticeHom A B where
  toFun := Subtype.val
  map_sSup' _ := rfl
  map_sInf' _ := rfl

@[simp] theorem inclusion_apply (A : CompleteSubalgebra B) (a : A) : inclusion A a = (a : B) := rfl

theorem inclusion_injective (A : CompleteSubalgebra B) :
    Function.Injective (inclusion A) :=
  Subtype.coe_injective

theorem inclusion_sSup (A : CompleteSubalgebra B) (S : Set A) :
    inclusion A (sSup S) = sSup (inclusion A '' S) := rfl

theorem inclusion_sInf (A : CompleteSubalgebra B) (S : Set A) :
    inclusion A (sInf S) = sInf (inclusion A '' S) := rfl

/-- An arbitrary intersection of complete subalgebras is complete. -/
def sInter (F : Set (CompleteSubalgebra B)) : CompleteSubalgebra B where
  toCompleteSublattice := CompleteSublattice.mk'
    {b | ∀ A ∈ F, b ∈ A}
    (by
      intro S hS A hA
      exact A.sSupClosed' (fun _ hb => hS hb A hA))
    (by
      intro S hS A hA
      exact A.sInfClosed' (fun _ hb => hS hb A hA))
  compl_mem' := by
    intro b hb A hA
    exact A.compl_mem' (hb A hA)

/-- The least complete Boolean subalgebra containing the given generators. -/
def generated (S : Set B) : CompleteSubalgebra B :=
  sInter {A | S ⊆ (A : Set B)}

theorem subset_generated {S : Set B} : S ⊆ generated S := fun _ hb _A hA => hA hb

theorem generated_le {S : Set B} {A : CompleteSubalgebra B}
    (hS : S ⊆ A) : generated S ≤ A :=
  fun _ hb => hb A hS

theorem generated_le_iff {S : Set B} {A : CompleteSubalgebra B} :
    generated S ≤ A ↔ S ⊆ A :=
  ⟨fun h => subset_generated.trans h, generated_le⟩

end Erdos1172CompleteSubalgebra
