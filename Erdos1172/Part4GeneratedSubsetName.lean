module

public import Erdos1172.Part4CompleteBooleanSubalgebra
public import Erdos1172.Part4BooleanNameTransport
public import Erdos1172.Part4InternalSubsetRepresentation

@[expose] public section

/-!
# A subset name inside its membership-generated complete subalgebra

Given any name x for a subset of a ground check A, construct the complete
subalgebra generated by its membership values and an actual name in that
smaller algebra. Transporting this name back recovers x under the SAME
condition that asserts x is a subset of check A.

Only ground-set members are used in the localized name. This does not
discard hereditary coefficients of arbitrary non-ground ambient names.
Nor does it assert that an arbitrary supplied x is the second-stage Cohen
generic of the anonymous collapse; that forcing iteration remains missing.
-/

set_option autoImplicit false

noncomputable section

open scoped Flypitch
open Lattice

universe u

namespace Erdos1172CompleteSubalgebra

variable {B : Type u} [NontrivialCompleteBooleanAlgebra B]

instance subtypeNontrivialCompleteBooleanAlgebra (S : CompleteSubalgebra B) :
    NontrivialCompleteBooleanAlgebra S where
  toCompleteBooleanAlgebra := inferInstance
  bot_lt_top := bot_lt_top

end Erdos1172CompleteSubalgebra

namespace bSet.ErdosGeneratedSubset

open Erdos1172CompleteSubalgebra ErdosNameTransport

variable {B : Type u} [NontrivialCompleteBooleanAlgebra B]

/-- An explicit subset name using coefficients from a complete subalgebra. -/
def indicatorIn (S : CompleteSubalgebra B) (A : PSet.{u}) (w : A.Type → S) : bSet S :=
  .mk A.Type (fun i => check (A.Func i)) w

theorem indicatorIn_subset (S : CompleteSubalgebra B) (A : PSet.{u})
    (w : A.Type → S) : (⊤ : S) ≤ indicatorIn S A w ⊆ᴮ check A := by
  rw [check_unfold, subset_unfold]
  apply le_iInf
  intro i
  change (⊤ : S) ≤ _root_.imp (w i)
    (check (A.Func i) ∈ᴮ .mk A.Type (fun j => check (A.Func j)) (fun _ => ⊤))
  rw [← deduction]
  exact le_top.trans (mem_mk' (check'' (fun j => check (A.Func j))) i)

theorem map_indicatorIn (S : CompleteSubalgebra B) (A : PSet.{u})
    (w : A.Type → S) :
    mapNames (inclusion S) (indicatorIn S A w) =
      .mk A.Type (fun i => check (A.Func i)) (fun i => (w i : B)) := by
  simp only [indicatorIn, mapNames_mk, map_check, inclusion_apply]

def membershipGenerators (A : PSet.{u}) (x : bSet B) : Set B :=
  Set.range (fun i : A.Type => (check (A.Func i) : bSet B) ∈ᴮ x)

def nameAlgebra (A : PSet.{u}) (x : bSet B) : CompleteSubalgebra B :=
  generated (membershipGenerators A x)

def membershipCoefficient (A : PSet.{u}) (x : bSet B) (i : A.Type) : nameAlgebra A x :=
  ⟨(check (A.Func i) : bSet B) ∈ᴮ x, subset_generated ⟨i, rfl⟩⟩

def localizedName (A : PSet.{u}) (x : bSet B) : bSet (nameAlgebra A x) :=
  indicatorIn (nameAlgebra A x) A (membershipCoefficient A x)

theorem localizedName_subset (A : PSet.{u}) (x : bSet B) :
    (⊤ : nameAlgebra A x) ≤ localizedName A x ⊆ᴮ check A :=
  indicatorIn_subset _ _ _

theorem map_localizedName (A : PSet.{u}) (x : bSet B) :
    mapNames (inclusion (nameAlgebra A x)) (localizedName A x) =
      set_of_indicator (u := check A) (fun i => (check A : bSet B).func i ∈ᴮ x) := by
  cases A with
  | mk ι f =>
    simp only [localizedName, map_indicatorIn, membershipCoefficient,
      set_of_indicator, check, bSet.type, bSet.func]
    rfl

/-- Recovery keeps the original Boolean condition; it is not silently
strengthened to top and is not required to belong to the smaller algebra. -/
theorem localizedName_recovers {A : PSet.{u}} {x : bSet B} {Γ : B}
    (Hx : Γ ≤ x ⊆ᴮ check A) :
    Γ ≤ x =ᴮ mapNames (inclusion (nameAlgebra A x)) (localizedName A x) := by
  rw [map_localizedName]
  exact eq_membership_indicator_of_subset Hx

/-- This is genuine complete generation, with no density-cardinality claim. -/
theorem nameAlgebra_le_iff (A : PSet.{u}) (x : bSet B) (S : CompleteSubalgebra B) :
    nameAlgebra A x ≤ S ↔ ∀ i : A.Type, ((check (A.Func i) : bSet B) ∈ᴮ x) ∈ S := by
  change generated (membershipGenerators A x) ≤ S ↔ _
  rw [generated_le_iff]
  exact Set.range_subset_iff

end bSet.ErdosGeneratedSubset
