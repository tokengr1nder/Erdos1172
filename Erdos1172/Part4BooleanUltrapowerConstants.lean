module

public import Mathlib.Order.Filter.CardinalInter
public import Erdos1172.Part4BooleanUltrapowerValues
public import Erdos1172.Part4LevyCohenIteration
public import Erdos1172.Part4LevyChainCondition

@[expose] public section

/-! # Complete embedding of constants for a chain-condition Boolean algebra

For a κ-complete ultrafilter, every large-domain choice in a fixed index
type of cardinality below κ is constant on a large set. Thus the value map
commutes with these indexed joins. If the source Boolean algebra has the
strict κ-chain condition, every join is generated by fewer than κ of its
terms. These two facts make the map of constants a complete embedding.
-/

set_option autoImplicit false
noncomputable section

open Filter

universe u

namespace Erdos1172BooleanUltrapower

variable {I B : Type u}

/-- The germ of a constant representative, viewed in the regular completion. -/
def constant [BooleanAlgebra B] (U : Ultrafilter I) (b : B) : Algebra U B :=
  value U (fun _ => b)

theorem constant_le_iff [BooleanAlgebra B] (U : Ultrafilter I) {b c : B} :
    constant U b ≤ constant U c ↔ b ≤ c :=
  (value_le_value_iff U).trans eventually_const

theorem constant_injective [BooleanAlgebra B] (U : Ultrafilter I) :
    Function.Injective (constant (B := B) U) := fun _ _ h =>
  le_antisymm ((constant_le_iff U).mp h.le) ((constant_le_iff U).mp h.ge)

variable [CompleteBooleanAlgebra B]

private theorem largeSelection_constant (U : Ultrafilter I) (κ : Cardinal.{u})
    [CardinalInterFilter (U : Filter I) κ] {T : Type u} (hT : Cardinal.mk T < κ)
    (s : LargeSelection U (fun _ => T)) :
    ∃ t : T, ∀ᶠ i in U, ∃ hi : i ∈ s.carrier, s.pick ⟨i, hi⟩ = t := by
  classical
  by_contra hn
  have hbad : ∀ t : T, ∀ᶠ i in U, ¬ ∃ hi : i ∈ s.carrier, s.pick ⟨i, hi⟩ = t :=
    fun t => U.eventually_not.mpr (fun h => hn ⟨t, h⟩)
  have hlarge : ∀ᶠ i in U, i ∈ s.carrier := s.large
  obtain ⟨i, hi, hnone⟩ := (hlarge.and ((eventually_cardinal_forall hT).mpr hbad)).exists
  exact hnone (s.pick ⟨i, hi⟩) ⟨hi, rfl⟩

theorem value_small_iSup (U : Ultrafilter I) (κ : Cardinal.{u})
    [CardinalInterFilter (U : Filter I) κ] {T : Type u} (hT : Cardinal.mk T < κ)
    (a : I → T → B) :
    value U (fun i => ⨆ t, a i t) = ⨆ t, value U (fun i => a i t) := by
  classical
  apply le_antisymm
  · rw [value_iSup U (fun _ => T) a]
    apply iSup_le
    intro s
    obtain ⟨t, ht⟩ := largeSelection_constant U κ hT s
    apply le_trans _ (le_iSup (fun t => value U (fun i => a i t)) t)
    apply (value_le_value_iff U).mpr
    filter_upwards [ht] with i hi
    obtain ⟨hm, heq⟩ := hi
    simp only [selected, dif_pos hm, heq, le_rfl]
  · apply iSup_le
    intro t
    exact (value_le_value_iff U).mpr (Eventually.of_forall fun i => le_iSup (a i) t)

/-- No positive pairwise-disjoint family of size κ exists. -/
def StrictCC (B : Type u) [CompleteBooleanAlgebra B] (κ : Cardinal.{u}) : Prop :=
  ∀ {J : Type u} (b : J → B), (∀ j, b j ≠ ⊥) →
    (∀ j k, j ≠ k → b j ⊓ b k = ⊥) → Cardinal.mk J < κ

/-- Keep the indices at which the running join grows. Their successive
differences form a positive antichain, so the retained subfamily is small. -/
theorem exists_small_subfamily (κ : Cardinal.{u}) (hcc : StrictCC B κ)
    {J : Type u} (a : J → B) :
    ∃ S : Set J, Cardinal.mk S < κ ∧ (⨆ j : S, a j.val) = ⨆ j, a j := by
  classical
  obtain ⟨_lo, wf⟩ := exists_wellFoundedLT J
  letI := _lo
  haveI : WellFoundedLT (J) := wf
  let past := fun j : J => ⨆ i : {i : J // i < j}, a i.val
  let w := fun j => a j ⊓ (past j)ᶜ
  let S := {j | w j ≠ ⊥}
  have hdisj {i j : J} (h : i < j) : w i ⊓ w j = ⊥ := by
    have hl : w i ≤ past j :=
      inf_le_left.trans (le_iSup (fun k : {k : J // k < j} => a k.val) ⟨i, h⟩)
    exact bot_unique ((inf_le_inf hl (show w j ≤ (past j)ᶜ from inf_le_right)).trans
      inf_compl_eq_bot.le)
  have hcard : Cardinal.mk S < κ := by
    apply hcc (fun j : S => w j.val) (fun j => j.property)
    intro i j hn
    have hn' : i.val ≠ j.val := fun h => hn (Subtype.ext h)
    rcases lt_or_gt_of_ne hn' with h | h
    · exact hdisj h
    · exact (inf_comm _ _).trans (hdisj h)
  refine ⟨S, hcard, le_antisymm (iSup_le fun j => le_iSup a j.val) (iSup_le ?_)⟩
  intro j
  apply wf.induction j
  intro k ih
  have hw : w k ≤ ⨆ j : S, a j.val := by
    by_cases h : w k = ⊥
    · exact h ▸ bot_le
    · exact inf_le_left.trans (le_iSup (fun j : S => a j.val) ⟨k, h⟩)
  calc
    a k = a k ⊓ past k ⊔ w k := by
      change a k = a k ⊓ past k ⊔ a k ⊓ (past k)ᶜ
      rw [← inf_sup_left, sup_compl_eq_top, inf_top_eq]
    _ ≤ ⨆ j : S, a j.val :=
      sup_le (inf_le_right.trans (iSup_le fun i : {i : J // i < k} => ih i.val i.property)) hw

theorem constant_iSup (U : Ultrafilter I) (κ : Cardinal.{u})
    [CardinalInterFilter (U : Filter I) κ] (hcc : StrictCC B κ)
    {J : Type u} (a : J → B) :
    constant U (⨆ j, a j) = ⨆ j, constant U (a j) := by
  obtain ⟨S, hcard, heq⟩ := exists_small_subfamily κ hcc a
  apply le_antisymm
  · calc
      constant U (⨆ j, a j) = constant U (⨆ j : S, a j.val) := congrArg (constant U) heq.symm
      _ = ⨆ j : S, constant U (a j.val) := value_small_iSup U κ hcard (fun _ j => a j.val)
      _ ≤ ⨆ j, constant U (a j) :=
        iSup_le fun j => le_iSup (fun k : J => constant U (a k)) j.val
  · exact iSup_le fun j => (constant_le_iff U).mpr (le_iSup a j)

theorem constant_iInf (U : Ultrafilter I) (κ : Cardinal.{u})
    [CardinalInterFilter (U : Filter I) κ] (hcc : StrictCC B κ)
    {J : Type u} (a : J → B) :
    constant U (⨅ j, a j) = ⨅ j, constant U (a j) := by
  have hc : ∀ b : B, constant U bᶜ = (constant U b)ᶜ := fun b => value_compl U (fun _ => b)
  apply compl_injective
  rw [← hc, compl_iInf, constant_iSup U κ hcc, compl_iInf]
  exact iSup_congr fun j => hc (a j)

def constantCompleteHom (U : Ultrafilter I) (κ : Cardinal.{u})
    [CardinalInterFilter (U : Filter I) κ] (hcc : StrictCC B κ) :
    CompleteLatticeHom B (Algebra U B) where
  toFun := constant U
  map_sSup' S := by rw [sSup_eq_iSup', sSup_image']; exact constant_iSup U κ hcc _
  map_sInf' S := by rw [sInf_eq_iInf', sInf_image']; exact constant_iInf U κ hcc _

theorem constantCompleteHom_apply (U : Ultrafilter I) (κ : Cardinal.{u})
    [CardinalInterFilter (U : Filter I) κ] (hcc : StrictCC B κ) (b : B) :
    constantCompleteHom U κ hcc b = value U (fun _ => b) := rfl

theorem constantCompleteHom_injective (U : Ultrafilter I) (κ : Cardinal.{u})
    [CardinalInterFilter (U : Filter I) κ] (hcc : StrictCC B κ) :
    Function.Injective (constantCompleteHom U κ hcc) := constant_injective U

open Erdos1172LevyCohen (FirstAlgebra)

/-- The actual Lévy collapse has strict κ-cc when κ is regular uncountable. -/
def firstCollapseConstantHom (U : Ultrafilter I) (κ : Cardinal.{u})
    [CardinalInterFilter (U : Filter I) κ] (hκ : κ.IsRegular) (hunc : Cardinal.aleph0 < κ) :
    CompleteLatticeHom (FirstAlgebra κ) (Algebra U (FirstAlgebra κ)) :=
  constantCompleteHom U κ (fun b hp hd =>
    Erdos1172LevyCollapse.below_completion_disjoint_family_cardinal_lt κ hκ hunc b hp hd)

theorem firstCollapseConstantHom_apply (U : Ultrafilter I) (κ : Cardinal.{u})
    [CardinalInterFilter (U : Filter I) κ] (hκ : κ.IsRegular) (hunc : Cardinal.aleph0 < κ)
    (b : FirstAlgebra κ) : firstCollapseConstantHom U κ hκ hunc b = value U (fun _ => b) := rfl

theorem firstCollapseConstantHom_injective (U : Ultrafilter I) (κ : Cardinal.{u})
    [CardinalInterFilter (U : Filter I) κ] (hκ : κ.IsRegular) (hunc : Cardinal.aleph0 < κ) :
    Function.Injective (firstCollapseConstantHom U κ hκ hunc) := constant_injective U

end Erdos1172BooleanUltrapower
