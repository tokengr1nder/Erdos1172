section AbstractRealization

private theorem completeHom_inf {X Y : Type u} [CompleteLattice X] [CompleteLattice Y]
    (e : CompleteLatticeHom X Y) (x y : X) : e (x ⊓ y) = e x ⊓ e y := by
  rw [← sInf_pair, sInfHomClass.map_sInf, Set.image_pair, sInf_pair]

/-- Boolean equivalence `(a ⊓ b) ⊔ (aᶜ ⊓ bᶜ)` in any Boolean algebra. -/
def bitiff {W : Type u} [BooleanAlgebra W] (a b : W) : W :=
  (a ⊓ b) ⊔ (aᶜ ⊓ bᶜ)

private theorem bitiff_inf_left {W : Type u} [BooleanAlgebra W] (c a b : W) :
    c ⊓ bitiff a b = ((c ⊓ a) ⊓ b) ⊔ ((c ⊓ aᶜ) ⊓ bᶜ) := by
  unfold bitiff
  rw [inf_sup_left, ← inf_assoc, ← inf_assoc]

private theorem bitiff_top_left {W : Type u} [BooleanAlgebra W] (b : W) :
    bitiff ⊤ b = b := by
  simp [bitiff]

private theorem bitiff_bot_left {W : Type u} [BooleanAlgebra W] (b : W) :
    bitiff ⊥ b = bᶜ := by
  simp [bitiff]

private theorem bitiff_comm {W : Type u} [BooleanAlgebra W] (a b : W) :
    (b ⊓ a) ⊔ (bᶜ ⊓ aᶜ) = bitiff a b := by
  unfold bitiff
  rw [inf_comm b a, inf_comm bᶜ aᶜ]

private theorem bitiff_congr_mask {A W : Type u} [CompleteBooleanAlgebra A] [CompleteBooleanAlgebra W]
    (F : CompleteLatticeHom A W) {u x y : A} (b : W) (hxy : u ⊓ y = u ⊓ x) :
    F u ⊓ bitiff (F x) b ≤ bitiff (F y) b := by
  have mask (v : A) : u ⊓ vᶜ = u ⊓ (u ⊓ v)ᶜ := by
    rw [compl_inf, inf_sup_left, inf_compl_eq_bot, bot_sup_eq]
  have hmc : u ⊓ xᶜ = u ⊓ yᶜ := (mask x).trans ((congrArg (fun z => u ⊓ zᶜ) hxy.symm).trans (mask y).symm)
  rw [bitiff_inf_left, ← completeHom_inf F, ← map_compl' F, ← completeHom_inf F,
    ← hxy, hmc, completeHom_inf F, completeHom_inf F, map_compl' F]
  exact sup_le
    ((inf_le_inf inf_le_right le_rfl).trans le_sup_left)
    ((inf_le_inf inf_le_right le_rfl).trans le_sup_right)

private theorem eq_bot_of_inf_and_inf_compl {α : Type u} [BooleanAlgebra α] {u v : α}
    (h1 : u ⊓ v = ⊥) (h0 : u ⊓ vᶜ = ⊥) : u = ⊥ := by
  calc
    u = u ⊓ (v ⊔ vᶜ) := by rw [sup_compl_eq_top, inf_top_eq]
    _ = (u ⊓ v) ⊔ (u ⊓ vᶜ) := inf_sup_left u v vᶜ
    _ = ⊥ := by rw [h1, h0, bot_sup_eq]

private theorem inf_right_idem_top {α : Type u} [BooleanAlgebra α] (u v : α) :
    (u ⊓ v) ⊓ v = (u ⊓ v) ⊓ ⊤ := by
  rw [inf_assoc, inf_idem, inf_top_eq]

private theorem bitiff_le_right_of_le {W : Type u} [BooleanAlgebra W] {x a b : W}
    (ha : x ≤ a) (hb : x ≤ bitiff a b) : x ≤ b := by
  have h : x ≤ a ⊓ bitiff a b := le_inf ha hb
  have hsimp : a ⊓ bitiff a b ≤ b := by
    unfold bitiff
    rw [inf_sup_left]
    apply sup_le (inf_le_right.trans inf_le_right)
    exact ((inf_le_inf le_rfl inf_le_left).trans inf_compl_eq_bot.le).trans bot_le
  exact h.trans hsimp

private theorem bitiff_le_compl_right_of_le_compl {W : Type u} [BooleanAlgebra W] {x a b : W}
    (ha : x ≤ aᶜ) (hb : x ≤ bitiff a b) : x ≤ bᶜ := by
  have h : x ≤ aᶜ ⊓ bitiff a b := le_inf ha hb
  have hsimp : aᶜ ⊓ bitiff a b ≤ bᶜ := by
    unfold bitiff
    rw [inf_sup_left]
    apply sup_le
    · exact ((inf_le_inf le_rfl inf_le_left).trans compl_inf_eq_bot.le).trans bot_le
    · exact inf_le_right.trans inf_le_right
  exact h.trans hsimp

/-- Realization of a canonical string condition `q : CohenCover.Condition θ (FirstAlgebra θ)`
inside a complete Boolean algebra `W` equipped with `F : CompleteLatticeHom (FirstAlgebra θ) W`
and bit sequence `B_bit : θ.ord.ToType → W`. -/
def realizeCondition {θ : Cardinal.{u}} {W : Type u} [CompleteBooleanAlgebra W]
    (F : CompleteLatticeHom (FirstAlgebra θ) W) (B_bit : θ.ord.ToType → W)
    (q : CohenCover.Condition θ (FirstAlgebra θ)) : W :=
  F q.value ⊓ ⨅ j : q.length.toOrd.val.ToType,
    bitiff (F (q.bits j)) (B_bit (StringName.includeIndex q.length.toOrd.property.le j))

theorem realizeCondition_mono {θ : Cardinal.{u}} {W : Type u} [CompleteBooleanAlgebra W]
    (F : CompleteLatticeHom (FirstAlgebra θ) W) (B_bit : θ.ord.ToType → W)
    {q₁ q₂ : CohenCover.Condition θ (FirstAlgebra θ)} (hle : q₁ ≤ q₂) :
    realizeCondition F B_bit q₁ ≤ realizeCondition F B_bit q₂ := by
  obtain ⟨hval, hlen, hbits⟩ := (CohenCover.Condition.le_iff q₁ q₂).mp hle
  refine le_inf (inf_le_left.trans (OrderHomClass.mono F hval)) (le_iInf fun j => ?_)
  let j' := StringName.includeIndex hlen j
  have hidx : StringName.includeIndex q₁.length.toOrd.property.le j' =
      StringName.includeIndex q₂.length.toOrd.property.le j := by
    apply Ordinal.ToType.mk.symm.injective
    exact Subtype.ext ((StringName.includeIndex_toOrd _ _).trans
      ((StringName.includeIndex_toOrd hlen j).trans (StringName.includeIndex_toOrd _ _).symm))
  have hj : realizeCondition F B_bit q₁ ≤ F q₁.value ⊓
      bitiff (F (q₁.bits j')) (B_bit (StringName.includeIndex q₂.length.toOrd.property.le j)) := by
    rw [← hidx]
    exact le_inf inf_le_left (inf_le_right.trans (iInf_le _ j'))
  exact hj.trans (bitiff_congr_mask F _ (hbits j))

/-- If every `realizeCondition F B_bit q` is nonzero and `θ.ord` is a limit ordinal, then
`realizeCondition F B_bit` reflects the `CohenCover.Condition` preorder. -/
theorem realizeCondition_le_iff {θ : Cardinal.{u}} {W : Type u} [CompleteBooleanAlgebra W]
    (hlim : Order.IsSuccLimit θ.ord)
    (F : CompleteLatticeHom (FirstAlgebra θ) W) (B_bit : θ.ord.ToType → W)
    (hpos : ∀ q : CohenCover.Condition θ (FirstAlgebra θ), realizeCondition F B_bit q ≠ ⊥)
    (q₁ q₂ : CohenCover.Condition θ (FirstAlgebra θ)) :
    realizeCondition F B_bit q₁ ≤ realizeCondition F B_bit q₂ ↔ q₁ ≤ q₂ := by
  refine ⟨fun hle => ?_, realizeCondition_mono F B_bit⟩
  rw [CohenCover.Condition.le_iff]
  have hval : q₁.value ≤ q₂.value := by
    by_contra hnv
    have hd : q₁.value ⊓ (q₂.value)ᶜ ≠ ⊥ := fun h0 =>
      hnv (disjoint_compl_right_iff.mp (disjoint_iff.mpr h0))
    let r := q₁.withValue (q₁.value ⊓ (q₂.value)ᶜ) hd
    have hr_le : realizeCondition F B_bit r ≤ realizeCondition F B_bit q₂ :=
      (realizeCondition_mono F B_bit (q₁.withValue_le _ hd inf_le_left)).trans hle
    have hr1 : realizeCondition F B_bit r ≤ F q₂.value := hr_le.trans inf_le_left
    have hr2 : realizeCondition F B_bit r ≤ (F q₂.value)ᶜ :=
      (inf_le_left.trans (OrderHomClass.mono F inf_le_right)).trans_eq (map_compl' F _)
    exact hpos r (le_bot_iff.mp ((le_inf hr1 hr2).trans inf_compl_eq_bot.le))
  have hlen : q₂.length.toOrd.val ≤ q₁.length.toOrd.val := by
    by_contra! hlt
    have hsucc : q₁.length.toOrd.val + 1 < θ.ord := hlim.succ_lt q₁.length.toOrd.property
    let l1 : θ.ord.ToType := Ordinal.ToType.mk ⟨q₁.length.toOrd.val + 1, hsucc⟩
    have hl1_eq : l1.toOrd.val = q₁.length.toOrd.val + 1 :=
      congrArg Subtype.val (Ordinal.ToType.mk.symm_apply_apply _)
    have hl1_le : q₁.length.toOrd.val ≤ l1.toOrd.val := hl1_eq ▸ Order.le_succ _
    let extBits (valBit : FirstAlgebra θ) (k : l1.toOrd.val.ToType) : FirstAlgebra θ :=
      if hk : k.toOrd.val < q₁.length.toOrd.val then
        q₁.bits (Ordinal.ToType.mk ⟨k.toOrd.val, hk⟩)
      else valBit
    let mkExt (d : FirstAlgebra θ) (hd : d ≠ ⊥) (valBit : FirstAlgebra θ) :
        CohenCover.Condition θ (FirstAlgebra θ) :=
      ⟨d, hd, l1, extBits valBit⟩
    have mkExt_le (d : FirstAlgebra θ) (hd : d ≠ ⊥) (hdq : d ≤ q₁.value) (valBit : FirstAlgebra θ) :
        mkExt d hd valBit ≤ q₁ := by
      refine (CohenCover.Condition.le_iff _ _).mpr ⟨hdq, hl1_le, fun j => ?_⟩
      let k := StringName.includeIndex hl1_le j
      have hk_ord : k.toOrd.val = j.toOrd.val := StringName.includeIndex_toOrd hl1_le j
      have hk_lt : k.toOrd.val < q₁.length.toOrd.val := hk_ord.symm ▸ j.toOrd.property
      change d ⊓ q₁.bits j = d ⊓ extBits valBit k
      simp only [extBits, dif_pos hk_lt]
      have hj_eq : (Ordinal.ToType.mk ⟨k.toOrd.val, hk_lt⟩ : q₁.length.toOrd.val.ToType) = j := by
        apply Ordinal.ToType.mk.symm.injective
        exact (Ordinal.ToType.mk.symm_apply_apply _).trans (Subtype.ext hk_ord)
      rw [hj_eq]
    let j₀ : q₂.length.toOrd.val.ToType := Ordinal.ToType.mk ⟨q₁.length.toOrd.val, hlt⟩
    have hj₀_ord : j₀.toOrd.val = q₁.length.toOrd.val :=
      congrArg Subtype.val (Ordinal.ToType.mk.symm_apply_apply _)
    let k₀ : l1.toOrd.val.ToType :=
      Ordinal.ToType.mk ⟨q₁.length.toOrd.val, hl1_eq ▸ Order.lt_succ (q₁.length.toOrd.val)⟩
    have hk₀_ord : k₀.toOrd.val = q₁.length.toOrd.val :=
      congrArg Subtype.val (Ordinal.ToType.mk.symm_apply_apply _)
    have hξ_eq : StringName.includeIndex l1.toOrd.property.le k₀ =
        StringName.includeIndex q₂.length.toOrd.property.le j₀ := by
      apply Ordinal.ToType.mk.symm.injective
      exact Subtype.ext ((StringName.includeIndex_toOrd _ _).trans
        (hk₀_ord.trans (hj₀_ord.symm.trans (StringName.includeIndex_toOrd _ _).symm)))
    let ξ₀ := StringName.includeIndex q₂.length.toOrd.property.le j₀
    have hd1 : q₁.value ⊓ q₂.bits j₀ = ⊥ := by
      by_contra hd1_ne
      let r := mkExt (q₁.value ⊓ q₂.bits j₀) hd1_ne ⊥
      have hr_q2 : realizeCondition F B_bit r ≤ realizeCondition F B_bit q₂ :=
        (realizeCondition_mono F B_bit (mkExt_le _ hd1_ne inf_le_left ⊥)).trans hle
      have hr_pos_bit : realizeCondition F B_bit r ≤ B_bit ξ₀ :=
        bitiff_le_right_of_le (inf_le_left.trans (OrderHomClass.mono F inf_le_right))
          (hr_q2.trans (inf_le_right.trans (iInf_le _ j₀)))
      have hk₀_not : ¬ k₀.toOrd.val < q₁.length.toOrd.val := by rw [hk₀_ord]; exact lt_irrefl _
      have hr_neg_bit : realizeCondition F B_bit r ≤ (B_bit ξ₀)ᶜ := by
        have h1 : realizeCondition F B_bit r ≤
            bitiff (F (extBits ⊥ k₀)) (B_bit (StringName.includeIndex l1.toOrd.property.le k₀)) :=
          inf_le_right.trans (iInf_le _ k₀)
        simpa only [extBits, dif_neg hk₀_not, BotHomClass.map_bot, bitiff_bot_left, hξ_eq] using h1
      exact hpos r (le_bot_iff.mp ((le_inf hr_pos_bit hr_neg_bit).trans inf_compl_eq_bot.le))
    have hd0 : q₁.value ⊓ (q₂.bits j₀)ᶜ = ⊥ := by
      by_contra hd0_ne
      let r := mkExt (q₁.value ⊓ (q₂.bits j₀)ᶜ) hd0_ne ⊤
      have hr_q2 : realizeCondition F B_bit r ≤ realizeCondition F B_bit q₂ :=
        (realizeCondition_mono F B_bit (mkExt_le _ hd0_ne inf_le_left ⊤)).trans hle
      have hr_neg_bit : realizeCondition F B_bit r ≤ (B_bit ξ₀)ᶜ :=
        bitiff_le_compl_right_of_le_compl
          ((inf_le_left.trans (OrderHomClass.mono F inf_le_right)).trans_eq (map_compl' F _))
          (hr_q2.trans (inf_le_right.trans (iInf_le _ j₀)))
      have hk₀_not : ¬ k₀.toOrd.val < q₁.length.toOrd.val := by rw [hk₀_ord]; exact lt_irrefl _
      have hr_pos_bit : realizeCondition F B_bit r ≤ B_bit ξ₀ := by
        have h1 : realizeCondition F B_bit r ≤
            bitiff (F (extBits ⊤ k₀)) (B_bit (StringName.includeIndex l1.toOrd.property.le k₀)) :=
          inf_le_right.trans (iInf_le _ k₀)
        simpa only [extBits, dif_neg hk₀_not, TopHomClass.map_top, bitiff_top_left, hξ_eq] using h1
      exact hpos r (le_bot_iff.mp ((le_inf hr_pos_bit hr_neg_bit).trans inf_compl_eq_bot.le))
    exact q₁.positive (eq_bot_of_inf_and_inf_compl hd1 hd0)
  refine ⟨hval, hlen, fun j => ?_⟩
  let j' := StringName.includeIndex hlen j
  have hξ : StringName.includeIndex q₁.length.toOrd.property.le j' =
      StringName.includeIndex q₂.length.toOrd.property.le j := by
    apply Ordinal.ToType.mk.symm.injective
    exact Subtype.ext ((StringName.includeIndex_toOrd _ _).trans
      ((StringName.includeIndex_toOrd hlen j).trans (StringName.includeIndex_toOrd _ _).symm))
  let ξ := StringName.includeIndex q₂.length.toOrd.property.le j
  have h_diff1 : (q₁.value ⊓ q₂.bits j) ⊓ (q₁.bits j')ᶜ = ⊥ := by
    by_contra hd
    let r := q₁.withValue ((q₁.value ⊓ q₂.bits j) ⊓ (q₁.bits j')ᶜ) hd
    have hr_q1 : realizeCondition F B_bit r ≤ realizeCondition F B_bit q₁ :=
      realizeCondition_mono F B_bit (q₁.withValue_le _ hd (inf_le_left.trans inf_le_left))
    have hr_q2 := hr_q1.trans hle
    have hb1 : realizeCondition F B_bit r ≤ B_bit ξ :=
      bitiff_le_right_of_le
        (inf_le_left.trans (OrderHomClass.mono F (inf_le_left.trans inf_le_right)))
        (hr_q2.trans (inf_le_right.trans (iInf_le _ j)))
    have hb0 : realizeCondition F B_bit r ≤ (B_bit ξ)ᶜ := by
      dsimp only [ξ]
      rw [← hξ]
      exact bitiff_le_compl_right_of_le_compl
        ((inf_le_left.trans (OrderHomClass.mono F inf_le_right)).trans_eq (map_compl' F _))
        (hr_q1.trans (inf_le_right.trans (iInf_le _ j')))
    exact hpos r (le_bot_iff.mp ((le_inf hb1 hb0).trans inf_compl_eq_bot.le))
  have h_diff2 : (q₁.value ⊓ q₁.bits j') ⊓ (q₂.bits j)ᶜ = ⊥ := by
    by_contra hd
    let r := q₁.withValue ((q₁.value ⊓ q₁.bits j') ⊓ (q₂.bits j)ᶜ) hd
    have hr_q1 : realizeCondition F B_bit r ≤ realizeCondition F B_bit q₁ :=
      realizeCondition_mono F B_bit (q₁.withValue_le _ hd (inf_le_left.trans inf_le_left))
    have hr_q2 := hr_q1.trans hle
    have hb1 : realizeCondition F B_bit r ≤ B_bit ξ := by
      dsimp only [ξ]
      rw [← hξ]
      exact bitiff_le_right_of_le
        (inf_le_left.trans (OrderHomClass.mono F (inf_le_left.trans inf_le_right)))
        (hr_q1.trans (inf_le_right.trans (iInf_le _ j')))
    have hb0 : realizeCondition F B_bit r ≤ (B_bit ξ)ᶜ :=
      bitiff_le_compl_right_of_le_compl
        ((inf_le_left.trans (OrderHomClass.mono F inf_le_right)).trans_eq (map_compl' F _))
        (hr_q2.trans (inf_le_right.trans (iInf_le _ j)))
    exact hpos r (le_bot_iff.mp ((le_inf hb1 hb0).trans inf_compl_eq_bot.le))
  exact le_antisymm
    (le_inf inf_le_left (disjoint_compl_right_iff.mp (disjoint_iff.mpr h_diff1)))
    (le_inf inf_le_left (disjoint_compl_right_iff.mp (disjoint_iff.mpr h_diff2)))

/-- Order isomorphism `Completion (CohenCover.Condition θ (FirstAlgebra θ)) ≃o W` from positivity
and density of `realizeCondition F B_bit`. -/
def realizeIso {θ : Cardinal.{u}} {W : Type u} [CompleteBooleanAlgebra W]
    (hlim : Order.IsSuccLimit θ.ord)
    (F : CompleteLatticeHom (FirstAlgebra θ) W) (B_bit : θ.ord.ToType → W)
    (hpos : ∀ q : CohenCover.Condition θ (FirstAlgebra θ), realizeCondition F B_bit q ≠ ⊥)
    (hdense : ∀ w : W, w ≠ ⊥ → ∃ q, realizeCondition F B_bit q ≤ w) :
    Completion (CohenCover.Condition θ (FirstAlgebra θ)) ≃o W := by
  let f : CohenCover.Condition θ (FirstAlgebra θ) →o Positive W :=
    ⟨fun q => ⟨realizeCondition F B_bit q, hpos q⟩, fun _ _ h => realizeCondition_mono F B_bit h⟩
  have hle_iff (a b : CohenCover.Condition θ (FirstAlgebra θ)) : f a ≤ f b ↔ a ≤ b :=
    realizeCondition_le_iff hlim F B_bit hpos a b
  have hl : Lifts f := fun t s hs => by
    obtain ⟨r, hr⟩ := hdense s.val s.property
    exact ⟨r, (hle_iff r t).mp ((show f r ≤ s from hr).trans hs), hr⟩
  have hc (a b : CohenCover.Condition θ (FirstAlgebra θ)) (h : f a ≤ f b) : ∃ z ≤ a, z ≤ b :=
    ⟨a, le_rfl, (hle_iff a b).mp h⟩
  have hd (s : Positive W) : ∃ q, f q ≤ s := hdense s.val s.property
  exact (ForcingCover.completionIso f hl hc hd).symm.trans
    (Erdos1172PositiveBoolean.completionOrderIso (B := W)).symm

theorem realizeIso_condition {θ : Cardinal.{u}} {W : Type u} [CompleteBooleanAlgebra W]
    (hlim : Order.IsSuccLimit θ.ord)
    (F : CompleteLatticeHom (FirstAlgebra θ) W) (B_bit : θ.ord.ToType → W)
    (hpos : ∀ q : CohenCover.Condition θ (FirstAlgebra θ), realizeCondition F B_bit q ≠ ⊥)
    (hdense : ∀ w : W, w ≠ ⊥ → ∃ q, realizeCondition F B_bit q ≤ w)
    (q : CohenCover.Condition θ (FirstAlgebra θ)) :
    realizeIso hlim F B_bit hpos hdense (condition q) = realizeCondition F B_bit q := by
  let f : CohenCover.Condition θ (FirstAlgebra θ) →o Positive W :=
    ⟨fun r => ⟨realizeCondition F B_bit r, hpos r⟩, fun _ _ h => realizeCondition_mono F B_bit h⟩
  have hle_iff (a b : CohenCover.Condition θ (FirstAlgebra θ)) : f a ≤ f b ↔ a ≤ b :=
    realizeCondition_le_iff hlim F B_bit hpos a b
  have hl : Lifts f := fun t s hs => by
    obtain ⟨r, hr⟩ := hdense s.val s.property
    exact ⟨r, (hle_iff r t).mp ((show f r ≤ s from hr).trans hs), hr⟩
  have hc (a b : CohenCover.Condition θ (FirstAlgebra θ)) (h : f a ≤ f b) : ∃ z ≤ a, z ≤ b :=
    ⟨a, le_rfl, (hle_iff a b).mp h⟩
  have hd (s : Positive W) : ∃ r, f r ≤ s := hdense s.val s.property
  let iso1 := ForcingCover.completionIso f hl hc hd
  have h1 : iso1 (condition (f q)) = condition q := ForcingCover.booleanHom_condition f hl hc q
  have h2 : iso1.symm (condition q) = condition (f q) := by
    rw [← h1, OrderIso.symm_apply_apply]
  change (Erdos1172PositiveBoolean.completionOrderIso (B := W)).symm (iso1.symm (condition q)) = _
  rw [h2, ← element_condition (f q), completionOrderIso_symm_apply]
  exact joinMembers_element (f q).val

/-- Every coordinate bit `B_bit ξ` is recovered solely from the realizations of canonical conditions
fixing coordinate `ξ` to `⊤`. -/
theorem realize_bit_eq_iSup {θ : Cardinal.{u}} {W : Type u} [CompleteBooleanAlgebra W]
    (hlim : Order.IsSuccLimit θ.ord)
    (F : CompleteLatticeHom (FirstAlgebra θ) W) (B_bit : θ.ord.ToType → W)
    (hpos : ∀ q : CohenCover.Condition θ (FirstAlgebra θ), realizeCondition F B_bit q ≠ ⊥)
    (hdense : ∀ w : W, w ≠ ⊥ → ∃ q, realizeCondition F B_bit q ≤ w)
    (ξ : θ.ord.ToType) :
    B_bit ξ = ⨆ q : {q : CohenCover.Condition θ (FirstAlgebra θ) //
      ∃ h : ξ.toOrd.val < q.length.toOrd.val, q.bits (Ordinal.ToType.mk ⟨ξ.toOrd.val, h⟩) = ⊤},
      realizeCondition F B_bit q.val := by
  classical
  let S := {q : CohenCover.Condition θ (FirstAlgebra θ) |
    ∃ h : ξ.toOrd.val < q.length.toOrd.val, q.bits (Ordinal.ToType.mk ⟨ξ.toOrd.val, h⟩) = ⊤}
  apply le_antisymm
  · by_contra hnot
    have hw : B_bit ξ ⊓ (⨆ q : S, realizeCondition F B_bit q.val)ᶜ ≠ ⊥ := fun h0 =>
      hnot (disjoint_compl_right_iff.mp (disjoint_iff.mpr h0))
    obtain ⟨q₀, hq₀⟩ := hdense _ hw
    have hq₀_bit : realizeCondition F B_bit q₀ ≤ B_bit ξ := hq₀.trans inf_le_left
    by_cases hlt : ξ.toOrd.val < q₀.length.toOrd.val
    · let j₀ : q₀.length.toOrd.val.ToType := Ordinal.ToType.mk ⟨ξ.toOrd.val, hlt⟩
      have hj₀_idx : StringName.includeIndex q₀.length.toOrd.property.le j₀ = ξ := by
        apply Ordinal.ToType.mk.symm.injective
        exact Subtype.ext ((StringName.includeIndex_toOrd _ _).trans
          (congrArg Subtype.val (Ordinal.ToType.mk.symm_apply_apply _)))
      have hd : q₀.value ⊓ q₀.bits j₀ ≠ ⊥ := by
        intro hd0
        have hle_c : q₀.value ≤ (q₀.bits j₀)ᶜ :=
          le_compl_iff_disjoint_right.mpr (disjoint_iff.mpr hd0)
        have hneg : realizeCondition F B_bit q₀ ≤ (B_bit ξ)ᶜ := by
          rw [← hj₀_idx]
          exact bitiff_le_compl_right_of_le_compl
            ((inf_le_left.trans (OrderHomClass.mono F hle_c)).trans_eq (map_compl' F _))
            (inf_le_right.trans (iInf_le _ j₀))
        exact hpos q₀ (le_bot_iff.mp ((le_inf hq₀_bit hneg).trans inf_compl_eq_bot.le))
      let q₁ : CohenCover.Condition θ (FirstAlgebra θ) :=
        ⟨q₀.value ⊓ q₀.bits j₀, hd, q₀.length, fun j => if j = j₀ then ⊤ else q₀.bits j⟩
      have hq₁_le : q₁ ≤ q₀ := by
        refine (CohenCover.Condition.le_iff _ _).mpr ⟨inf_le_left, le_rfl, fun j => ?_⟩
        have hinc : StringName.includeIndex (le_refl q₀.length.toOrd.val) j = j :=
          Ordinal.ToType.mk.symm.injective (Subtype.ext (StringName.includeIndex_toOrd le_rfl j))
        change (q₀.value ⊓ q₀.bits j₀) ⊓ q₀.bits j =
          (q₀.value ⊓ q₀.bits j₀) ⊓ (if StringName.includeIndex le_rfl j = j₀ then ⊤ else q₀.bits _)
        rw [hinc]
        split_ifs with hj
        · subst hj
          exact inf_right_idem_top q₀.value (q₀.bits j₀)
        · rfl
      have hq₁_mem : q₁ ∈ S := ⟨hlt, if_pos rfl⟩
      have h1 : realizeCondition F B_bit q₁ ≤ (⨆ q : S, realizeCondition F B_bit q.val)ᶜ :=
        (realizeCondition_mono F B_bit hq₁_le).trans (hq₀.trans inf_le_right)
      have h2 : realizeCondition F B_bit q₁ ≤ ⨆ q : S, realizeCondition F B_bit q.val :=
        le_iSup (fun q : S => realizeCondition F B_bit q.val) ⟨q₁, hq₁_mem⟩
      exact hpos q₁ (le_bot_iff.mp ((le_inf h2 h1).trans inf_compl_eq_bot.le))
    · have hle_len : q₀.length.toOrd.val ≤ ξ.toOrd.val := le_of_not_gt hlt
      have hsucc : ξ.toOrd.val + 1 < θ.ord := hlim.succ_lt ξ.toOrd.property
      let l1 : θ.ord.ToType := Ordinal.ToType.mk ⟨ξ.toOrd.val + 1, hsucc⟩
      have hl1_ord : l1.toOrd.val = ξ.toOrd.val + 1 :=
        congrArg Subtype.val (Ordinal.ToType.mk.symm_apply_apply _)
      have hl1_ge : q₀.length.toOrd.val ≤ l1.toOrd.val := hl1_ord ▸ (hle_len.trans (Order.le_succ _))
      let q₁ : CohenCover.Condition θ (FirstAlgebra θ) :=
        ⟨q₀.value, q₀.positive, l1, fun k =>
          if hk : k.toOrd.val < q₀.length.toOrd.val then
            q₀.bits (Ordinal.ToType.mk ⟨k.toOrd.val, hk⟩)
          else ⊤⟩
      have hq₁_le : q₁ ≤ q₀ := by
        refine (CohenCover.Condition.le_iff _ _).mpr ⟨le_rfl, hl1_ge, fun j => ?_⟩
        let k := StringName.includeIndex hl1_ge j
        have hk_ord : k.toOrd.val = j.toOrd.val := StringName.includeIndex_toOrd hl1_ge j
        have hk_lt : k.toOrd.val < q₀.length.toOrd.val := hk_ord.symm ▸ j.toOrd.property
        change q₀.value ⊓ q₀.bits j = q₀.value ⊓ q₁.bits k
        simp only [q₁, dif_pos hk_lt]
        have hj_eq : (Ordinal.ToType.mk ⟨k.toOrd.val, hk_lt⟩ : q₀.length.toOrd.val.ToType) = j := by
          apply Ordinal.ToType.mk.symm.injective
          exact (Ordinal.ToType.mk.symm_apply_apply _).trans (Subtype.ext hk_ord)
        rw [hj_eq]
      have hξ_l1 : ξ.toOrd.val < l1.toOrd.val := hl1_ord ▸ Order.lt_succ _
      have hq₁_mem : q₁ ∈ S := by
        refine ⟨hξ_l1, ?_⟩
        let kξ : l1.toOrd.val.ToType := Ordinal.ToType.mk ⟨ξ.toOrd.val, hξ_l1⟩
        have hkξ_ord : kξ.toOrd.val = ξ.toOrd.val :=
          congrArg Subtype.val (Ordinal.ToType.mk.symm_apply_apply _)
        have hkξ_not : ¬ kξ.toOrd.val < q₀.length.toOrd.val := hkξ_ord ▸ hlt
        exact dif_neg hkξ_not
      have h1 : realizeCondition F B_bit q₁ ≤ (⨆ q : S, realizeCondition F B_bit q.val)ᶜ :=
        (realizeCondition_mono F B_bit hq₁_le).trans (hq₀.trans inf_le_right)
      have h2 : realizeCondition F B_bit q₁ ≤ ⨆ q : S, realizeCondition F B_bit q.val :=
        le_iSup (fun q : S => realizeCondition F B_bit q.val) ⟨q₁, hq₁_mem⟩
      exact hpos q₁ (le_bot_iff.mp ((le_inf h2 h1).trans inf_compl_eq_bot.le))
  · refine iSup_le fun ⟨q, hlt, htop⟩ => ?_
    let j₀ : q.length.toOrd.val.ToType := Ordinal.ToType.mk ⟨ξ.toOrd.val, hlt⟩
    have hj₀_idx : StringName.includeIndex q.length.toOrd.property.le j₀ = ξ := by
      apply Ordinal.ToType.mk.symm.injective
      exact Subtype.ext ((StringName.includeIndex_toOrd _ _).trans
        (congrArg Subtype.val (Ordinal.ToType.mk.symm_apply_apply _)))
    have h1 : realizeCondition F B_bit q ≤
        bitiff (F (q.bits j₀)) (B_bit (StringName.includeIndex q.length.toOrd.property.le j₀)) :=
      inf_le_right.trans (iInf_le _ j₀)
    simpa only [j₀, htop, TopHomClass.map_top, bitiff_top_left, hj₀_idx] using h1

end AbstractRealization

section LevyCohenRealization
open ErdosCohen ErdosPartialInjection Erdos1172BooleanNameIteration Erdos1172CohenIteration

/-- The `ξ`-th binary decision value in `Erdos1172LevyCohen.Algebra θ`. -/
def levyCohenBit (θ : Cardinal.{u}) (ξ : θ.ord.ToType) : Erdos1172LevyCohen.Algebra θ :=
  Erdos1172CohenIteration.bitValue (omegaOne : bSet (FirstAlgebra θ))
    (check (PSet.ordinalMk ξ.toOrd.val)) (1 : bSet (FirstAlgebra θ))

theorem levyCohenBit_eq_mem_cohenSubset (θ : Cardinal.{u}) (ξ : θ.ord.ToType) :
    levyCohenBit θ ξ =
      ((check (PSet.ordinalMk ξ.toOrd.val) : bSet (Erdos1172LevyCohen.Algebra θ)) ∈ᴮ cohenSubset θ) := by
  obtain ⟨i, hi⟩ := PSet.mem_iff.mp (PSet.mk_mem_mk_of_lt (show ξ.toOrd.val < θ.ord from ξ.toOrd.property))
  have hchk_C : (⊤ : Erdos1172LevyCohen.Algebra θ) ≤
      check ((PSet.ordinalMk θ.ord).Func i) =ᴮ check (PSet.ordinalMk ξ.toOrd.val) :=
    check_bv_eq (PSet.Equiv.symm hi)
  have hchk_F : (⊤ : FirstAlgebra θ) ≤
      check ((PSet.ordinalMk θ.ord).Func i) =ᴮ check (PSet.ordinalMk ξ.toOrd.val) :=
    check_bv_eq (PSet.Equiv.symm hi)
  have hmem : ((check ((PSet.ordinalMk θ.ord).Func i) : bSet (Erdos1172LevyCohen.Algebra θ)) ∈ᴮ cohenSubset θ) =
      ((check (PSet.ordinalMk ξ.toOrd.val) : bSet (Erdos1172LevyCohen.Algebra θ)) ∈ᴮ cohenSubset θ) :=
    (bv_rw (top_unique hchk_C) (fun z => z ∈ᴮ cohenSubset θ) (h_congr := B_ext_mem_left)).symm
  have hbit : Erdos1172CohenIteration.bitValue (omegaOne : bSet (FirstAlgebra θ))
        (check ((PSet.ordinalMk θ.ord).Func i)) 1 = levyCohenBit θ ξ := by
    unfold levyCohenBit Erdos1172CohenIteration.bitValue
    apply le_antisymm
    · refine iSup_le fun ⟨p, hp⟩ => condition_le_bitValue ?_
      exact mem_congr (pair_congr (le_top.trans hchk_F) bv_refl) bv_refl hp
    · refine iSup_le fun ⟨p, hp⟩ => condition_le_bitValue ?_
      exact mem_congr (pair_congr (le_top.trans (bv_symm hchk_F)) bv_refl) bv_refl hp
  rw [← hmem, cohenSubset_member_eq_bitValue θ i, hbit]

theorem levyCohenBit_mem_anonymousAlgebra (θ : Cardinal.{u}) (ξ : θ.ord.ToType) :
    levyCohenBit θ ξ ∈ anonymousAlgebra θ := by
  obtain ⟨i, hi⟩ := PSet.mem_iff.mp (PSet.mk_mem_mk_of_lt (show ξ.toOrd.val < θ.ord from ξ.toOrd.property))
  have hchk_F : (⊤ : FirstAlgebra θ) ≤
      check ((PSet.ordinalMk θ.ord).Func i) =ᴮ check (PSet.ordinalMk ξ.toOrd.val) :=
    check_bv_eq (PSet.Equiv.symm hi)
  have hbit : Erdos1172CohenIteration.bitValue (omegaOne : bSet (FirstAlgebra θ))
        (check ((PSet.ordinalMk θ.ord).Func i)) 1 = levyCohenBit θ ξ := by
    unfold levyCohenBit Erdos1172CohenIteration.bitValue
    apply le_antisymm
    · refine iSup_le fun ⟨p, hp⟩ => condition_le_bitValue ?_
      exact mem_congr (pair_congr (le_top.trans hchk_F) bv_refl) bv_refl hp
    · refine iSup_le fun ⟨p, hp⟩ => condition_le_bitValue ?_
      exact mem_congr (pair_congr (le_top.trans (bv_symm hchk_F)) bv_refl) bv_refl hp
  rw [← hbit]
  exact bitValue_mem_anonymousAlgebra θ i

private theorem stringName_mem_conditions (θ : Cardinal.{u}) (hreg : θ.IsRegular) (hunc : ℵ₀ < θ)
    {γ : Ordinal.{u}} (hγ : γ < θ.ord) (s : StringName (FirstAlgebra θ) γ) :
    (⊤ : FirstAlgebra θ) ≤ s.name ∈ᴮ ErdosCohen.conditions omegaOne := by
  have hmem : (⊤ : FirstAlgebra θ) ≤ check (PSet.ordinalMk γ) ∈ᴮ (omegaOne : bSet (FirstAlgebra θ)) :=
    bv_rw'' (ϕ := fun z => check (PSet.ordinalMk γ) ∈ᴮ z)
      (Erdos1172LevyCollapse.below_checked_upper_eq_omegaOne θ hreg hunc)
      (check_mem (PSet.mk_mem_mk_of_lt hγ)) B_ext_mem_right
  have hsub : (⊤ : FirstAlgebra θ) ≤ check (PSet.ordinalMk γ) ⊆ᴮ (omegaOne : bSet (FirstAlgebra θ)) :=
    subset_of_mem_Ord hmem omegaOne_Ord
  exact ErdosCohen.mem_conditions_iff.mpr
    (le_inf (subset_trans' (subset_prod_of_is_function s.isFunction) (prod_domain_mono hsub))
      (le_inf (s.isFunction.trans (inf_le_left.trans inf_le_left))
        (le_iSup_of_le (check (PSet.ordinalMk γ))
          (le_inf hmem (injects_into_of_subset
            (subset_of_eq (graphDomain_eq_of_function hsub s.isFunction)))))))

private theorem condition_le_levyCohenRealize (θ : Cardinal.{u})
    (q : CohenCover.Condition θ (FirstAlgebra θ))
    (r : Erdos1172CohenIteration.Conditions (omegaOne : bSet (FirstAlgebra θ)))
    (hr_val : r.value ≤ q.value) (hr_eq : r.value ≤ q.name.name =ᴮ name r) :
    condition r ≤ realizeCondition (Erdos1172LevyCohen.firstStageHom θ) (levyCohenBit θ) q := by
  let F := Erdos1172LevyCohen.firstStageHom θ
  have hfirst : condition r ≤ F r.value :=
    (Erdos1172CohenIteration.condition_le_firstStageHom_iff _ _ _).mpr le_rfl
  refine le_inf (hfirst.trans (OrderHomClass.mono F hr_val)) (le_iInf fun j => ?_)
  let ξ := StringName.includeIndex q.length.toOrd.property.le j
  have hξ_ord : ξ.toOrd.val = j.toOrd.val := StringName.includeIndex_toOrd _ _
  have hlbl : (StringName.label j : bSet (FirstAlgebra θ)) = check (PSet.ordinalMk ξ.toOrd.val) :=
    congrArg (fun o => check (PSet.ordinalMk o)) hξ_ord.symm
  have h1 : r.value ⊓ q.bits j ≤ pair (check (PSet.ordinalMk ξ.toOrd.val)) 1 ∈ᴮ name r := by
    have hm : q.bits j ≤ pair (StringName.label j) 1 ∈ᴮ q.name.name := by
      change q.bits j ≤ q.name.bits j
      rw [CohenCover.Condition.name, StringName.bits_ofBits]
    rw [hlbl] at hm
    exact mem_congr bv_refl (inf_le_left.trans hr_eq) (inf_le_right.trans hm)
  have h0 : r.value ⊓ (q.bits j)ᶜ ≤ pair (check (PSet.ordinalMk ξ.toOrd.val)) 0 ∈ᴮ name r := by
    have hm : (q.bits j)ᶜ ≤ pair (StringName.label j) 0 ∈ᴮ q.name.name := by
      rw [StringName.zero_value, CohenCover.Condition.name, StringName.bits_ofBits]
    rw [hlbl] at hm
    exact mem_congr bv_refl (inf_le_left.trans hr_eq) (inf_le_right.trans hm)
  have hagr := condition_binary_agreement h1 h0
  exact hagr.trans_eq (bitiff_comm (F (q.bits j)) (levyCohenBit θ ξ))

/-- Every canonical iteration condition refines to a total `StringName` condition of length at
least a prescribed `minLen : θ.ord.ToType`. -/
private theorem exists_string_refinement (θ : Cardinal.{u}) (hθ : θ.IsInaccessible)
    (r : Erdos1172CohenIteration.Conditions (omegaOne : bSet (FirstAlgebra θ)))
    (minLen : θ.ord.ToType) :
    ∃ (len : θ.ord.ToType) (_ : minLen.toOrd.val ≤ len.toOrd.val)
      (bits : len.toOrd.val.ToType → FirstAlgebra θ)
      (r' : Erdos1172CohenIteration.Conditions (omegaOne : bSet (FirstAlgebra θ))),
      r' ≤ r ∧ r'.value ≤ (StringName.ofBits len.toOrd.val bits).name =ᴮ name r' := by
  classical
  have hrc : r.value ≤ ErdosCohen.condition omegaOne (name r) :=
    ErdosCohen.mem_conditions_iff.mp (name_mem r)
  have hcov : r.value ≤ ⨆ l : θ.ord.ToType,
      graphDomain (omegaOne : bSet (FirstAlgebra θ)) two (name r) ⊆ᴮ
        check (PSet.ordinalMk l.toOrd.val) :=
    firstStage_condition_domain_bound_cover θ hθ.isRegular hθ.aleph0_lt hrc
  have hex : ∃ l : θ.ord.ToType,
      r.value ⊓ (graphDomain (omegaOne : bSet (FirstAlgebra θ)) two (name r) ⊆ᴮ
        check (PSet.ordinalMk l.toOrd.val)) ≠ ⊥ := by
    by_contra hnone
    have hbot : (⨆ l : θ.ord.ToType, r.value ⊓
        (graphDomain omegaOne two (name r) ⊆ᴮ check (PSet.ordinalMk l.toOrd.val))) = ⊥ :=
      iSup_eq_bot.mpr fun l => by_contra fun h => hnone ⟨l, h⟩
    exact r.nonzero ((inf_eq_left.mpr hcov).symm.trans ((inf_iSup_eq _ _).trans hbot))
  obtain ⟨l₀, hl₀_ne⟩ := hex
  let len : θ.ord.ToType := max minLen l₀
  have hmin : minLen.toOrd.val ≤ len.toOrd.val :=
    Ordinal.ToType.mk.symm.le_iff_le.mpr (le_max_left _ _)
  have hl₀_len : l₀.toOrd.val ≤ len.toOrd.val :=
    Ordinal.ToType.mk.symm.le_iff_le.mpr (le_max_right _ _)
  have hmono_chk : (⊤ : FirstAlgebra θ) ≤
      check (PSet.ordinalMk l₀.toOrd.val) ⊆ᴮ check (PSet.ordinalMk len.toOrd.val) := by
    rw [subset_unfold]
    refine le_iInf fun i => ?_
    rw [check_bval_top, top_imp, check_func]
    obtain ⟨α, hα, heq⟩ := PSet.mem_ordinalMk_iff.mp (PSet.func_mem _ _)
    exact check_mem (PSet.mem_ordinalMk_iff.mpr ⟨α, hα.trans_le hl₀_len, heq⟩)
  let d := r.value ⊓ (graphDomain (omegaOne : bSet (FirstAlgebra θ)) two (name r) ⊆ᴮ
    check (PSet.ordinalMk len.toOrd.val))
  have hd_ge : r.value ⊓ (graphDomain omegaOne two (name r) ⊆ᴮ check (PSet.ordinalMk l₀.toOrd.val)) ≤ d :=
    le_inf inf_le_left (subset_trans' inf_le_right (le_top.trans hmono_chk))
  have hd_ne : d ≠ ⊥ := fun h0 => hl₀_ne (le_bot_iff.mp (hd_ge.trans_eq h0))
  let bits (j : len.toOrd.val.ToType) : FirstAlgebra θ := pair (StringName.label j) 1 ∈ᴮ name r
  let t := StringName.ofBits len.toOrd.val bits
  let S_len : PSet.{u} := PSet.mk len.toOrd.val.ToType (fun j => PSet.ordinalMk j.toOrd.val)
  have hS_eq : PSet.ordinalMk len.toOrd.val = S_len := PSet.ordinalMk_eq_def len.toOrd.val
  have hd_sub : d ≤ name r ⊆ᴮ t.name := by
    have hfunc_r : d ≤ is_function (graphDomain omegaOne two (name r)) two (name r) :=
      ErdosCohen.condition_function (inf_le_left.trans hrc)
    have hprod : d ≤ name r ⊆ᴮ prod (check S_len) two := by
      rw [← hS_eq]
      exact subset_trans' (subset_prod_of_is_function hfunc_r) (prod_domain_mono inf_le_right)
    apply subset_by_binary_pairs S_len (name r) t.name d hprod
    · intro j
      let j' : len.toOrd.val.ToType := j
      have hm : bits j' ≤ pair (StringName.label j') 1 ∈ᴮ t.name := by
        change bits j' ≤ t.bits j'
        rw [StringName.bits_ofBits]
      exact inf_le_right.trans hm
    · intro j
      let j' : len.toOrd.val.ToType := j
      have hr_func : d ≤ is_func (name r) :=
        (inf_le_left.trans hrc).trans (inf_le_right.trans inf_le_left)
      have hdisj : d ⊓ (pair (StringName.label j') 0 ∈ᴮ name r) ≤ (bits j')ᶜ := by
        apply le_compl_iff_disjoint_right.mpr
        apply disjoint_iff_inf_le.mpr
        exact bot_of_zero_eq_one (eq_of_is_func_of_eq ((inf_le_left.trans inf_le_left).trans hr_func)
          bv_refl (inf_le_left.trans inf_le_right) inf_le_right)
      have hm0 : (bits j')ᶜ ≤ pair (StringName.label j') 0 ∈ᴮ t.name := by
        rw [StringName.zero_value, StringName.bits_ofBits]
      exact hdisj.trans hm0
  obtain ⟨r', hr'_le_r, _, hr'_eq⟩ := exists_extension_refinement r hd_ne inf_le_left
    (le_top.trans (stringName_mem_conditions θ hθ.isRegular hθ.aleph0_lt len.toOrd.property t)) hd_sub
  exact ⟨len, hmin, bits, r', hr'_le_r, hr'_eq⟩

theorem levyCohenRealize_ne_bot (θ : Cardinal.{u}) (hθ : θ.IsInaccessible)
    (q : CohenCover.Condition θ (FirstAlgebra θ)) :
    realizeCondition (Erdos1172LevyCohen.firstStageHom θ) (levyCohenBit θ) q ≠ ⊥ := by
  obtain ⟨r, hr_val, hr_eq⟩ := exists_canonical_refinement q.positive
    (le_top.trans (stringName_mem_conditions θ hθ.isRegular hθ.aleph0_lt q.length.toOrd.property q.name))
  intro h0
  exact condition_ne_bot r (le_bot_iff.mp ((condition_le_levyCohenRealize θ q r hr_val hr_eq).trans_eq h0))

theorem levyCohenRealize_dense (θ : Cardinal.{u}) (hθ : θ.IsInaccessible)
    {w : Erdos1172LevyCohen.Algebra θ} (hw : w ≠ ⊥) :
    ∃ q : CohenCover.Condition θ (FirstAlgebra θ),
      realizeCondition (Erdos1172LevyCohen.firstStageHom θ) (levyCohenBit θ) q ≤ w := by
  classical
  let F := Erdos1172LevyCohen.firstStageHom θ
  obtain ⟨r, hrw⟩ := exists_condition_le hw
  let zeroOrd : θ.ord.ToType := Ordinal.ToType.mk ⟨0, hθ.isRegular.ord_pos⟩
  obtain ⟨len, _, bits, r', hr'_le_r, hr'_eq⟩ := exists_string_refinement θ hθ r zeroOrd
  let q : CohenCover.Condition θ (FirstAlgebra θ) := ⟨r'.value, r'.nonzero, len, bits⟩
  refine ⟨q, ?_⟩
  suffices hle_r' : realizeCondition F (levyCohenBit θ) q ≤ condition r' from
    hle_r'.trans ((condition_mono hr'_le_r).trans hrw)
  by_contra hnot
  have hpos_diff : realizeCondition F (levyCohenBit θ) q ⊓ (condition r')ᶜ ≠ ⊥ := fun h0 =>
    hnot (disjoint_compl_right_iff.mp (disjoint_iff.mpr h0))
  obtain ⟨p, hp⟩ := exists_condition_le hpos_diff
  obtain ⟨len₂, hlen₂, bits₂, p', hp'_le_p, hp'_eq⟩ := exists_string_refinement θ hθ p len
  let q₂ : CohenCover.Condition θ (FirstAlgebra θ) := ⟨p'.value, p'.nonzero, len₂, bits₂⟩
  have hp'_q₂ : condition p' ≤ realizeCondition F (levyCohenBit θ) q₂ :=
    condition_le_levyCohenRealize θ q₂ p' le_rfl hp'_eq
  have hp'_q : condition p' ≤ realizeCondition F (levyCohenBit θ) q :=
    (condition_mono hp'_le_p).trans (hp.trans inf_le_left)
  have hlim : Order.IsSuccLimit θ.ord := Cardinal.isSuccLimit_ord hθ.aleph0_lt.le
  -- Meet q₂ with q by checking q₂ ≤ q? Even simpler: check bits agreement directly on p'.value!
  have hp'_val : p'.value ≤ r'.value :=
    (Erdos1172CohenIteration.condition_le_firstStageHom_iff _ _ _).mp (hp'_q.trans inf_le_left)
  have hbits_eq (j : len.toOrd.val.ToType) :
      p'.value ⊓ bits j = p'.value ⊓ bits₂ (StringName.includeIndex hlen₂ j) := by
    let j' := StringName.includeIndex hlen₂ j
    have hξ : StringName.includeIndex len₂.toOrd.property.le j' =
        StringName.includeIndex len.toOrd.property.le j := by
      apply Ordinal.ToType.mk.symm.injective
      exact Subtype.ext ((StringName.includeIndex_toOrd _ _).trans
        ((StringName.includeIndex_toOrd hlen₂ j).trans (StringName.includeIndex_toOrd _ _).symm))
    let ξ := StringName.includeIndex len.toOrd.property.le j
    have hd1 : (p'.value ⊓ bits j) ⊓ (bits₂ j')ᶜ = ⊥ := by
      by_contra hd
      let s := shrink p' ((p'.value ⊓ bits j) ⊓ (bits₂ j')ᶜ) hd (inf_le_left.trans inf_le_left)
      have hs_p' : condition s ≤ condition p' := condition_mono (shrink_le _ _ _ _)
      have hs_b1 : condition s ≤ levyCohenBit θ ξ :=
        bitiff_le_right_of_le
          ((Erdos1172CohenIteration.condition_le_firstStageHom_iff _ _ _).mpr
            (inf_le_left.trans inf_le_right))
          (hs_p'.trans (hp'_q.trans (inf_le_right.trans (iInf_le _ j))))
      have hs_b0 : condition s ≤ (levyCohenBit θ ξ)ᶜ := by
        dsimp only [ξ]
        rw [← hξ]
        exact bitiff_le_compl_right_of_le_compl
          (((Erdos1172CohenIteration.condition_le_firstStageHom_iff _ _ _).mpr
            inf_le_right).trans_eq (map_compl' F _))
          (hs_p'.trans (hp'_q₂.trans (inf_le_right.trans (iInf_le _ j'))))
      exact condition_ne_bot s (le_bot_iff.mp ((le_inf hs_b1 hs_b0).trans inf_compl_eq_bot.le))
    have hd2 : (p'.value ⊓ bits₂ j') ⊓ (bits j)ᶜ = ⊥ := by
      by_contra hd
      let s := shrink p' ((p'.value ⊓ bits₂ j') ⊓ (bits j)ᶜ) hd (inf_le_left.trans inf_le_left)
      have hs_p' : condition s ≤ condition p' := condition_mono (shrink_le _ _ _ _)
      have hs_b1 : condition s ≤ levyCohenBit θ ξ := by
        dsimp only [ξ]
        rw [← hξ]
        exact bitiff_le_right_of_le
          ((Erdos1172CohenIteration.condition_le_firstStageHom_iff _ _ _).mpr
            (inf_le_left.trans inf_le_right))
          (hs_p'.trans (hp'_q₂.trans (inf_le_right.trans (iInf_le _ j'))))
      have hs_b0 : condition s ≤ (levyCohenBit θ ξ)ᶜ :=
        bitiff_le_compl_right_of_le_compl
          (((Erdos1172CohenIteration.condition_le_firstStageHom_iff _ _ _).mpr
            inf_le_right).trans_eq (map_compl' F _))
          (hs_p'.trans (hp'_q.trans (inf_le_right.trans (iInf_le _ j))))
      exact condition_ne_bot s (le_bot_iff.mp ((le_inf hs_b1 hs_b0).trans inf_compl_eq_bot.le))
    exact le_antisymm
      (le_inf inf_le_left (disjoint_compl_right_iff.mp (disjoint_iff.mpr hd1)))
      (le_inf inf_le_left (disjoint_compl_right_iff.mp (disjoint_iff.mpr hd2)))
  have hext : p'.value ≤ q.name.name ⊆ᴮ q₂.name.name := by
    have h := extensionValue_of_bits (CompleteLatticeHom.id (FirstAlgebra θ))
      q.name q₂.name hlen₂ p'.value (fun j => by
        simp only [CohenCover.Condition.name, StringName.bits_ofBits, CompleteLatticeHom.id_apply]
        exact hbits_eq j)
    simpa only [extensionValue, StringName.map_id] using h
  have hp'_le_r' : p' ≤ r' :=
    ⟨hp'_val, subset_trans' (subset_of_eq (bv_symm (hp'_val.trans hr'_eq)))
      (subset_trans' hext (subset_of_eq hp'_eq))⟩
  have h1 : condition p' ≤ condition r' := condition_mono hp'_le_r'
  have h2 : condition p' ≤ (condition r')ᶜ :=
    (condition_mono hp'_le_p).trans (hp.trans inf_le_right)
  exact condition_ne_bot p' (le_bot_iff.mp ((le_inf h1 h2).trans inf_compl_eq_bot.le))

/-- Canonical order isomorphism `Completion (CohenCover.Condition θ (FirstAlgebra θ)) ≃o Erdos1172LevyCohen.Algebra θ`. -/
def cohenCoverToLevyCohenIso (θ : Cardinal.{u}) (hθ : θ.IsInaccessible) :
    Completion (CohenCover.Condition θ (FirstAlgebra θ)) ≃o Erdos1172LevyCohen.Algebra θ :=
  realizeIso (Cardinal.isSuccLimit_ord hθ.aleph0_lt.le)
    (Erdos1172LevyCohen.firstStageHom θ) (levyCohenBit θ)
    (levyCohenRealize_ne_bot θ hθ) (fun _ hw => levyCohenRealize_dense θ hθ hw)

end LevyCohenRealization

section UltrapowerRealization
variable {I : Type u} {κ θ : Cardinal.{u}} (U : Ultrafilter I) (a : I → Set θ.ord.ToType)

private theorem value_bitiff {B : Type u} [BooleanAlgebra B] (f g : I → B) :
    bitiff (value U f) (value U g) = value U (fun i => bitiff (f i) (g i)) := by
  have h1 : value U f ⊓ value U g = value U (fun i => f i ⊓ g i) :=
    (Erdos1172BooleanUltrapower.value_inf U f g).symm
  have h2 : (value U f)ᶜ ⊓ (value U g)ᶜ = value U (fun i => (f i)ᶜ ⊓ (g i)ᶜ) :=
    (congrArg₂ (· ⊓ ·) (value_compl U f).symm (value_compl U g).symm).trans
      (Erdos1172BooleanUltrapower.value_inf U _ _).symm
  exact (congrArg₂ (· ⊔ ·) h1 h2).trans (Erdos1172BooleanUltrapower.value_sup U _ _).symm

private theorem value_inf_eq {B : Type u} [BooleanAlgebra B] (f g : I → B) :
    value U f ⊓ value U g = value U (fun i => f i ⊓ g i) :=
  (value_inf U f g).symm

include a in
theorem value_fine_iInf [Nonempty θ.ord.ToType] {J D : Type u} [CompleteBooleanAlgebra D]
    (hf : FineOn U a) (hn : NormalOn U a) (idx : J ↪ θ.ord.ToType) (b : J → I → D) :
    value U (fun i => ⨅ j : {j : J // idx j ∈ a i}, b j.val i) = ⨅ j, value U (b j) := by
  apply compl_injective
  rw [← value_compl, compl_iInf]
  simp only [compl_iInf]
  exact (value_fine_iSup U a hf hn idx (fun j i => (b j i)ᶜ)).trans
    (iSup_congr fun j => value_compl U (b j))

/-- The `ξ`-th binary decision value in the Boolean ultrapower
`Algebra U (Erdos1172LevyCohen.Algebra κ)`. -/
def ultrapowerLevyCohenBit (ξ : θ.ord.ToType) :
    Erdos1172BooleanUltrapower.Algebra U (Erdos1172LevyCohen.Algebra κ) := by
  classical
  exact value U (fun i =>
    if h : Nonempty (κ.ord.ToType ≃o a i) ∧ ξ ∈ a i then
      levyCohenBit κ ((Classical.choice h.1).symm ⟨ξ, h.2⟩)
    else ⊤)

variable [CountableInterFilter (U : Filter I)] [Nonempty θ.ord.ToType]
variable (hk : κ ≤ θ) (hf : FineOn U a) (hn : NormalOn U a) (ht : FiberOrderType U κ θ a)

/-- First-stage complete Boolean homomorphism `FirstAlgebra θ → Algebra U (Erdos1172LevyCohen.Algebra κ)`. -/
def ultrapowerFirstStageHom :
    CompleteLatticeHom (FirstAlgebra θ)
      (Erdos1172BooleanUltrapower.Algebra U (Erdos1172LevyCohen.Algebra κ)) :=
  (scalarHom U (Erdos1172LevyCohen.firstStageHom κ)).comp
    (CompleteLatticeHom.OrderIso.toCompleteLatticeHom (collapseCompletionIso U a hk hf hn ht).symm)

include hk hf hn ht in
theorem ultrapowerRealize_ne_bot (hκ : κ.IsInaccessible)
    (q : CohenCover.Condition θ (FirstAlgebra θ)) :
    realizeCondition (ultrapowerFirstStageHom U a hk hf hn ht) (ultrapowerLevyCohenBit U a) q ≠ ⊥ := by
  classical
  let φ := collapseCompletionIso U a hk hf hn ht
  have huθ : ℵ₀ < θ := hκ.aleph0_lt.trans_le hk
  obtain ⟨v, hv_eq⟩ := exists_prepared_coefficient U a hf hn hk ht huθ q.value
  have hv_symm : φ.symm q.value = value U v := φ.injective (by rw [OrderIso.apply_symm_apply, hv_eq])
  have hv_ne_bot : value U v ≠ ⊥ := fun h0 =>
    q.positive (hv_eq.symm.trans ((congrArg φ h0).trans (map_bot φ)))
  have hv_pos : ∀ᶠ i in U, v i ≠ ⊥ := U.eventually_not.mpr fun h0 =>
    hv_ne_bot ((value_eq_of_eventuallyEq U (g := fun _ => ⊥) h0).trans (value_bot U))
  choose b hb_eq using fun j : q.length.toOrd.val.ToType =>
    exists_prepared_coefficient U a hf hn hk ht huθ (q.bits j)
  have hb_symm (j : q.length.toOrd.val.ToType) : φ.symm (q.bits j) = value U (b j) :=
    φ.injective (by rw [OrderIso.apply_symm_apply, hb_eq j])
  let defaultLen : κ.ord.ToType := Ordinal.ToType.mk ⟨0, hκ.isRegular.ord_pos⟩
  let L_at (i : I) : κ.ord.ToType :=
    if h : Nonempty (κ.ord.ToType ≃o a i) ∧ q.length ∈ a i then
      (Classical.choice h.1).symm ⟨q.length, h.2⟩
    else defaultLen
  let bit_at (i : I) (k : (L_at i).toOrd.val.ToType) : FirstAlgebra κ :=
    if h : Nonempty (κ.ord.ToType ≃o a i) ∧ q.length ∈ a i then
      let iso := Classical.choice h.1
      let k_full : κ.ord.ToType := StringName.includeIndex (L_at i).toOrd.property.le k
      if hlt : (iso k_full).val.toOrd.val < q.length.toOrd.val then
        b (Ordinal.ToType.mk ⟨(iso k_full).val.toOrd.val, hlt⟩) i
      else ⊥
    else ⊥
  let g (i : I) : Erdos1172LevyCohen.Algebra κ :=
    if hv : v i ≠ ⊥ then
      realizeCondition (Erdos1172LevyCohen.firstStageHom κ) (levyCohenBit κ)
        ⟨v i, hv, L_at i, bit_at i⟩
    else ⊤
  have hg_pos : ∀ᶠ i in U, g i ≠ ⊥ := Eventually.of_forall fun i => by
    dsimp only [g]
    split_ifs with hvi
    · exact levyCohenRealize_ne_bot κ hκ _
    · exact top_ne_bot
  have hval_g_ne : value U g ≠ ⊥ := by
    intro h0
    have hev : ∀ᶠ i in U, g i ≤ ⊥ := (value_le_value_iff U).mp (h0.trans (value_bot U).symm).le
    obtain ⟨i, hgi, hbot⟩ := (hg_pos.and hev).exists
    exact hgi (le_bot_iff.mp hbot)
  suffices hle : value U g ≤
      realizeCondition (ultrapowerFirstStageHom U a hk hf hn ht) (ultrapowerLevyCohenBit U a) q from
    fun h0 => hval_g_ne (le_bot_iff.mp (hle.trans_eq h0))
  refine le_inf ?_ (le_iInf fun j => ?_)
  · change value U g ≤ scalarHom U (Erdos1172LevyCohen.firstStageHom κ) (φ.symm q.value)
    rw [hv_symm, scalarHom_value]
    apply (value_le_value_iff U).mpr (hv_pos.mono fun i hvi => ?_)
    simp only [g, dif_pos hvi]
    exact inf_le_left
  · let ξ := StringName.includeIndex q.length.toOrd.property.le j
    have hξ_ord : ξ.toOrd.val = j.toOrd.val := StringName.includeIndex_toOrd _ _
    have hξ_lt : ξ < q.length :=
      Ordinal.ToType.mk.symm.lt_iff_lt.mp (hξ_ord.trans_lt j.toOrd.property)
    have hF_bit : ultrapowerFirstStageHom U a hk hf hn ht (q.bits j) =
        value U (fun i => Erdos1172LevyCohen.firstStageHom κ (b j i)) := by
      change scalarHom U (Erdos1172LevyCohen.firstStageHom κ) (φ.symm (q.bits j)) = _
      rw [hb_symm j, scalarHom_value]
    rw [hF_bit]
    unfold ultrapowerLevyCohenBit
    erw [value_bitiff U]
    apply (value_le_value_iff U).mpr
    filter_upwards [hv_pos, ht, hf q.length, hf ξ] with i hvi hti hlen_mem hξ_mem
    have hcond_len : Nonempty (κ.ord.ToType ≃o a i) ∧ q.length ∈ a i := ⟨hti, hlen_mem⟩
    have hcond_ξ : Nonempty (κ.ord.ToType ≃o a i) ∧ ξ ∈ a i := ⟨hti, hξ_mem⟩
    let iso := Classical.choice hti
    let k_ξ : κ.ord.ToType := iso.symm ⟨ξ, hξ_mem⟩
    have hk_lt_L : k_ξ < L_at i := by
      dsimp only [L_at]
      rw [dif_pos hcond_len]
      exact iso.symm.lt_iff_lt.mpr hξ_lt
    have hk_ord_lt : k_ξ.toOrd.val < (L_at i).toOrd.val :=
      Ordinal.ToType.mk.symm.lt_iff_lt.mpr hk_lt_L
    let k₀ : (L_at i).toOrd.val.ToType := Ordinal.ToType.mk ⟨k_ξ.toOrd.val, hk_ord_lt⟩
    have hk₀_inc : StringName.includeIndex (L_at i).toOrd.property.le k₀ = k_ξ := by
      apply Ordinal.ToType.mk.symm.injective
      exact Subtype.ext ((StringName.includeIndex_toOrd _ _).trans
        (congrArg Subtype.val (Ordinal.ToType.mk.symm_apply_apply _)))
    have hiso_k : (iso k_ξ).val = ξ := congrArg Subtype.val (iso.apply_symm_apply ⟨ξ, hξ_mem⟩)
    have hbit_at : bit_at i k₀ = b j i := by
      dsimp only [bit_at]
      rw [dif_pos hcond_len]
      have hlt' : (iso (StringName.includeIndex (L_at i).toOrd.property.le k₀)).val.toOrd.val <
          q.length.toOrd.val := by
        rw [hk₀_inc, hiso_k, hξ_ord]
        exact j.toOrd.property
      rw [dif_pos hlt']
      have hj_eq : (Ordinal.ToType.mk
          ⟨(iso (StringName.includeIndex (L_at i).toOrd.property.le k₀)).val.toOrd.val, hlt'⟩ :
          q.length.toOrd.val.ToType) = j := by
        apply Ordinal.ToType.mk.symm.injective
        exact (Ordinal.ToType.mk.symm_apply_apply _).trans
          (Subtype.ext ((congrArg (fun x : θ.ord.ToType => x.toOrd.val)
            ((congrArg (fun k => (iso k).val) hk₀_inc).trans hiso_k)).trans hξ_ord))
      rw [hj_eq]
    dsimp only [ξ] at hcond_ξ ⊢
    simp only [g, dif_pos hvi, dif_pos hcond_ξ]
    have hproj : realizeCondition (Erdos1172LevyCohen.firstStageHom κ) (levyCohenBit κ)
        ⟨v i, hvi, L_at i, bit_at i⟩ ≤
        bitiff (Erdos1172LevyCohen.firstStageHom κ (bit_at i k₀))
          (levyCohenBit κ (StringName.includeIndex (L_at i).toOrd.property.le k₀)) :=
      inf_le_right.trans (iInf_le _ k₀)
    rwa [hbit_at, hk₀_inc] at hproj

include hk hf hn ht in
theorem ultrapowerRealize_dense (hκ : κ.IsInaccessible)
    {z : Erdos1172BooleanUltrapower.Algebra U (Erdos1172LevyCohen.Algebra κ)} (hz : z ≠ ⊥) :
    ∃ q : CohenCover.Condition θ (FirstAlgebra θ),
      realizeCondition (ultrapowerFirstStageHom U a hk hf hn ht) (ultrapowerLevyCohenBit U a) q ≤ z := by
  classical
  let φ := collapseCompletionIso U a hk hf hn ht
  obtain ⟨g, _, hg_pos, hg_le⟩ := exists_supported_lower_bound_levyCohen U a hk hf hn ht hκ hz
  let defaultQ : CohenCover.Condition κ (FirstAlgebra κ) :=
    CohenCover.Condition.empty hκ.pos ⊤ top_ne_bot
  let pickQ (c : Erdos1172LevyCohen.Algebra κ) : CohenCover.Condition κ (FirstAlgebra κ) :=
    if hc : c ≠ ⊥ then (levyCohenRealize_dense κ hκ hc).choose else defaultQ
  have hpickQ_le {c : Erdos1172LevyCohen.Algebra κ} (hc : c ≠ ⊥) :
      realizeCondition (Erdos1172LevyCohen.firstStageHom κ) (levyCohenBit κ) (pickQ c) ≤ c := by
    simp only [pickQ, dif_pos hc]
    exact (levyCohenRealize_dense κ hκ hc).choose_spec
  let q_i (i : I) := pickQ (g i)
  have hlen_in : ∀ᶠ i in U, fiberEmbedding a hk i (q_i i).length ∈ a i :=
    (fiber_range U a hk ht).mono fun i hri => hri ▸ Set.mem_range_self _
  obtain ⟨L_up, hL_up⟩ := hn (fun i => fiberEmbedding a hk i (q_i i).length) hlen_in
  let Q_val : FirstAlgebra θ := φ (value U (fun i => (q_i i).value))
  have hQ_pos : Q_val ≠ ⊥ := by
    intro h0
    have hv0 : value U (fun i => (q_i i).value) = ⊥ :=
      φ.injective (h0.trans (map_bot φ).symm)
    have hev : ∀ᶠ i in U, (q_i i).value ≤ ⊥ :=
      (value_le_value_iff U).mp (hv0.trans (value_bot U).symm).le
    obtain ⟨i, hbi⟩ := hev.exists
    exact (q_i i).positive (le_bot_iff.mp hbi)
  let idxEmb : L_up.toOrd.val.ToType ↪ θ.ord.ToType :=
    ⟨StringName.includeIndex L_up.toOrd.property.le, fun x y h => by
      apply Ordinal.ToType.mk.symm.injective
      exact Subtype.ext ((StringName.includeIndex_toOrd _ _).symm.trans
        ((congrArg (fun t : θ.ord.ToType => t.toOrd.val) h).trans (StringName.includeIndex_toOrd _ _)))⟩
  let b_j (j : L_up.toOrd.val.ToType) (i : I) : FirstAlgebra κ :=
    if h : Nonempty (κ.ord.ToType ≃o a i) ∧ idxEmb j ∈ a i then
      let k := (Classical.choice h.1).symm ⟨idxEmb j, h.2⟩
      if hk_lt : k.toOrd.val < (q_i i).length.toOrd.val then
        (q_i i).bits (Ordinal.ToType.mk ⟨k.toOrd.val, hk_lt⟩)
      else ⊥
    else ⊥
  let Q : CohenCover.Condition θ (FirstAlgebra θ) :=
    ⟨Q_val, hQ_pos, L_up, fun j => φ (value U (b_j j))⟩
  refine ⟨Q, ?_⟩
  have hreal_le_g : value U (fun i =>
      realizeCondition (Erdos1172LevyCohen.firstStageHom κ) (levyCohenBit κ) (q_i i)) ≤ z :=
    ((value_le_value_iff U).mpr (hg_pos.mono fun i hgi => hpickQ_le hgi)).trans hg_le
  suffices heq : realizeCondition (ultrapowerFirstStageHom U a hk hf hn ht)
      (ultrapowerLevyCohenBit U a) Q =
      value U (fun i => realizeCondition (Erdos1172LevyCohen.firstStageHom κ) (levyCohenBit κ) (q_i i)) by
    exact heq.le.trans hreal_le_g
  unfold realizeCondition
  have hfirst : ultrapowerFirstStageHom U a hk hf hn ht Q.value =
      value U (fun i => Erdos1172LevyCohen.firstStageHom κ (q_i i).value) := by
    change scalarHom U (Erdos1172LevyCohen.firstStageHom κ) (φ.symm (φ _)) = _
    rw [OrderIso.symm_apply_apply, scalarHom_value]
  rw [hfirst]
  erw [← value_inf_eq U]
  apply congrArg (value U (fun i => Erdos1172LevyCohen.firstStageHom κ (q_i i).value) ⊓ ·)
  let term_i (j : L_up.toOrd.val.ToType) (i : I) : Erdos1172LevyCohen.Algebra κ :=
    bitiff (Erdos1172LevyCohen.firstStageHom κ (b_j j i))
      (if h : Nonempty (κ.ord.ToType ≃o a i) ∧ idxEmb j ∈ a i then
        levyCohenBit κ ((Classical.choice h.1).symm ⟨idxEmb j, h.2⟩)
      else ⊤)
  have hterm_val (j : L_up.toOrd.val.ToType) :
      bitiff (ultrapowerFirstStageHom U a hk hf hn ht (Q.bits j)) (ultrapowerLevyCohenBit U a (idxEmb j)) =
      value U (term_i j) := by
    have hFb : ultrapowerFirstStageHom U a hk hf hn ht (Q.bits j) =
        value U (fun i => Erdos1172LevyCohen.firstStageHom κ (b_j j i)) := by
      change scalarHom U (Erdos1172LevyCohen.firstStageHom κ) (φ.symm (φ _)) = _
      rw [OrderIso.symm_apply_apply, scalarHom_value]
    rw [hFb]
    unfold ultrapowerLevyCohenBit term_i
    exact value_bitiff U _ _
  change (⨅ j : L_up.toOrd.val.ToType, bitiff (ultrapowerFirstStageHom U a hk hf hn ht (Q.bits j))
      (ultrapowerLevyCohenBit U a (idxEmb j))) = _
  simp_rw [hterm_val]
  rw [← value_fine_iInf U a hf hn idxEmb term_i]
  apply value_eq_of_eventuallyEq
  filter_upwards [ht, hL_up] with i hti hLi
  let iso := Classical.choice hti
  have hiso_L : (iso (q_i i).length).val = L_up := by
    simp only [fiberEmbedding, dif_pos hti] at hLi
    exact hLi
  apply le_antisymm
  · refine le_iInf fun k => ?_
    let k_full : κ.ord.ToType := StringName.includeIndex (q_i i).length.toOrd.property.le k
    have hk_ord : k_full.toOrd.val = k.toOrd.val := StringName.includeIndex_toOrd _ _
    have hk_lt_len : k_full < (q_i i).length :=
      Ordinal.ToType.mk.symm.lt_iff_lt.mp (hk_ord.trans_lt k.toOrd.property)
    have hiso_lt : (iso k_full).val < L_up := hiso_L ▸ iso.lt_iff_lt.mpr hk_lt_len
    have hiso_ord_lt : (iso k_full).val.toOrd.val < L_up.toOrd.val :=
      Ordinal.ToType.mk.symm.lt_iff_lt.mpr hiso_lt
    let j : L_up.toOrd.val.ToType := Ordinal.ToType.mk ⟨(iso k_full).val.toOrd.val, hiso_ord_lt⟩
    have hj_idx : idxEmb j = (iso k_full).val := by
      apply Ordinal.ToType.mk.symm.injective
      exact Subtype.ext ((StringName.includeIndex_toOrd L_up.toOrd.property.le j).trans
        (congrArg Subtype.val (Ordinal.ToType.mk.symm_apply_apply _)))
    have hj_mem : idxEmb j ∈ a i := hj_idx ▸ (iso k_full).property
    have hcond : Nonempty (κ.ord.ToType ≃o a i) ∧ idxEmb j ∈ a i := ⟨hti, hj_mem⟩
    have hsymm : iso.symm ⟨idxEmb j, hj_mem⟩ = k_full := by
      apply iso.injective
      rw [iso.apply_symm_apply]
      exact Subtype.ext hj_idx
    have hb_eq_k : b_j j i = (q_i i).bits k := by
      dsimp only [b_j]
      rw [dif_pos hcond]
      have hlt' : (iso.symm ⟨idxEmb j, hj_mem⟩).toOrd.val < (q_i i).length.toOrd.val := by
        rw [hsymm, hk_ord]
        exact k.toOrd.property
      rw [dif_pos hlt']
      have hk_eq : (Ordinal.ToType.mk ⟨(iso.symm ⟨idxEmb j, hj_mem⟩).toOrd.val, hlt'⟩ :
          (q_i i).length.toOrd.val.ToType) = k := by
        apply Ordinal.ToType.mk.symm.injective
        exact (Ordinal.ToType.mk.symm_apply_apply _).trans
          (Subtype.ext ((congrArg (fun x : κ.ord.ToType => x.toOrd.val) hsymm).trans hk_ord))
      rw [hk_eq]
    refine (iInf_le (fun s : {s : L_up.toOrd.val.ToType // idxEmb s ∈ a i} => term_i s.val i)
      ⟨j, hj_mem⟩).trans_eq ?_
    dsimp only [term_i]
    rw [hb_eq_k, dif_pos hcond, hsymm]
  · refine le_iInf fun ⟨j, hj_mem⟩ => ?_
    have hcond : Nonempty (κ.ord.ToType ≃o a i) ∧ idxEmb j ∈ a i := ⟨hti, hj_mem⟩
    let k_full : κ.ord.ToType := iso.symm ⟨idxEmb j, hj_mem⟩
    have hj_lt_L : idxEmb j < L_up :=
      Ordinal.ToType.mk.symm.lt_iff_lt.mp
        ((StringName.includeIndex_toOrd L_up.toOrd.property.le j).trans_lt j.toOrd.property)
    have hk_lt_len : k_full < (q_i i).length := by
      apply iso.lt_iff_lt.mp
      change (iso k_full).val < (iso (q_i i).length).val
      rw [show (iso k_full).val = idxEmb j from congrArg Subtype.val (iso.apply_symm_apply _), hiso_L]
      exact hj_lt_L
    have hk_ord_lt : k_full.toOrd.val < (q_i i).length.toOrd.val :=
      Ordinal.ToType.mk.symm.lt_iff_lt.mpr hk_lt_len
    let k : (q_i i).length.toOrd.val.ToType := Ordinal.ToType.mk ⟨k_full.toOrd.val, hk_ord_lt⟩
    have hk_inc : StringName.includeIndex (q_i i).length.toOrd.property.le k = k_full := by
      apply Ordinal.ToType.mk.symm.injective
      exact Subtype.ext ((StringName.includeIndex_toOrd _ _).trans
        (congrArg Subtype.val (Ordinal.ToType.mk.symm_apply_apply _)))
    have hb_eq_k : b_j j i = (q_i i).bits k := by
      dsimp only [b_j]
      rw [dif_pos hcond, dif_pos hk_ord_lt]
    refine (iInf_le _ k).trans_eq ?_
    dsimp only [term_i]
    rw [hb_eq_k, dif_pos hcond, hk_inc]

/-- Canonical order isomorphism identifying `Algebra U (Erdos1172LevyCohen.Algebra κ)` with
`Erdos1172LevyCohen.Algebra θ`. -/
def levyCohenUltrapowerIso (hκ : κ.IsInaccessible) (hθ : θ.IsInaccessible) :
    Erdos1172BooleanUltrapower.Algebra U (Erdos1172LevyCohen.Algebra κ) ≃o
      Erdos1172LevyCohen.Algebra θ :=
  (realizeIso (Cardinal.isSuccLimit_ord hθ.aleph0_lt.le)
    (ultrapowerFirstStageHom U a hk hf hn ht) (ultrapowerLevyCohenBit U a)
    (ultrapowerRealize_ne_bot U a hk hf hn ht hκ)
    (fun _ hz => ultrapowerRealize_dense U a hk hf hn ht hκ hz)).symm.trans
    (cohenCoverToLevyCohenIso θ hθ)

theorem levyCohenUltrapowerIso_realize (hκ : κ.IsInaccessible) (hθ : θ.IsInaccessible)
    (q : CohenCover.Condition θ (FirstAlgebra θ)) :
    levyCohenUltrapowerIso U a hk hf hn ht hκ hθ
      (realizeCondition (ultrapowerFirstStageHom U a hk hf hn ht) (ultrapowerLevyCohenBit U a) q) =
      realizeCondition (Erdos1172LevyCohen.firstStageHom θ) (levyCohenBit θ) q := by
  let isoU := realizeIso (Cardinal.isSuccLimit_ord hθ.aleph0_lt.le)
    (ultrapowerFirstStageHom U a hk hf hn ht) (ultrapowerLevyCohenBit U a)
    (ultrapowerRealize_ne_bot U a hk hf hn ht hκ)
    (fun _ hz => ultrapowerRealize_dense U a hk hf hn ht hκ hz)
  let isoC := cohenCoverToLevyCohenIso θ hθ
  have h1 : isoU (condition q) =
      realizeCondition (ultrapowerFirstStageHom U a hk hf hn ht) (ultrapowerLevyCohenBit U a) q :=
    realizeIso_condition _ _ _ _ _ q
  change isoC (isoU.symm _) = _
  rw [← h1, OrderIso.symm_apply_apply]
  exact realizeIso_condition _ _ _ _ _ q

theorem levyCohenUltrapowerIso_bit (hκ : κ.IsInaccessible) (hθ : θ.IsInaccessible)
    (ξ : θ.ord.ToType) :
    levyCohenUltrapowerIso U a hk hf hn ht hκ hθ (ultrapowerLevyCohenBit U a ξ) =
      levyCohenBit θ ξ := by
  let hlim := Cardinal.isSuccLimit_ord hθ.aleph0_lt.le
  let ψ : CompleteLatticeHom
      (Erdos1172BooleanUltrapower.Algebra U (Erdos1172LevyCohen.Algebra κ))
      (Erdos1172LevyCohen.Algebra θ) :=
    CompleteLatticeHom.OrderIso.toCompleteLatticeHom (levyCohenUltrapowerIso U a hk hf hn ht hκ hθ)
  change ψ (ultrapowerLevyCohenBit U a ξ) = levyCohenBit θ ξ
  rw [realize_bit_eq_iSup hlim (ultrapowerFirstStageHom U a hk hf hn ht) (ultrapowerLevyCohenBit U a)
    (ultrapowerRealize_ne_bot U a hk hf hn ht hκ)
    (fun _ hz => ultrapowerRealize_dense U a hk hf hn ht hκ hz) ξ,
    realize_bit_eq_iSup hlim (Erdos1172LevyCohen.firstStageHom θ) (levyCohenBit θ)
    (levyCohenRealize_ne_bot θ hθ) (fun _ hw => levyCohenRealize_dense θ hθ hw) ξ,
    _root_.map_iSup ψ]
  exact iSup_congr fun q => levyCohenUltrapowerIso_realize U a hk hf hn ht hκ hθ q.val

/-- Lift a lower `CohenCover.Condition κ (FirstAlgebra κ)` to `CohenCover.Condition θ (FirstAlgebra θ)`
along `initialCollapseHom hk` and `initialCoordinate hk`. -/
def initialLiftCoverCondition (q : CohenCover.Condition κ (FirstAlgebra κ)) :
    CohenCover.Condition θ (FirstAlgebra θ) where
  value := initialCollapseHom hk q.value
  positive := fun h0 => q.positive (initialCollapseHom_injective hk
    (h0.trans (BotHomClass.map_bot (initialCollapseHom hk)).symm))
  length := initialCoordinate hk q.length
  bits j :=
    have hj : j.toOrd.val < q.length.toOrd.val :=
      (show j.toOrd.val < (initialCoordinate hk q.length).toOrd.val from j.toOrd.property).trans_eq
        (initialCoordinate_ordinal hk q.length)
    initialCollapseHom hk (q.bits (Ordinal.ToType.mk ⟨j.toOrd.val, hj⟩))

include hk hf hn ht in
theorem levyCohenUltrapowerIso_constant_realize [CardinalInterFilter (U : Filter I) κ]
    (hκ : κ.IsInaccessible) (hθ : θ.IsInaccessible)
    (q : CohenCover.Condition κ (FirstAlgebra κ)) :
    levyCohenUltrapowerIso U a hk hf hn ht hκ hθ
      (value U (fun _ => realizeCondition (Erdos1172LevyCohen.firstStageHom κ) (levyCohenBit κ) q)) =
      realizeCondition (Erdos1172LevyCohen.firstStageHom θ) (levyCohenBit θ)
        (initialLiftCoverCondition hk q) := by
  rw [← levyCohenUltrapowerIso_realize U a hk hf hn ht hκ hθ (initialLiftCoverCondition hk q)]
  apply congrArg (levyCohenUltrapowerIso U a hk hf hn ht hκ hθ)
  let φ := collapseCompletionIso U a hk hf hn ht
  have hconst_φ (x : FirstAlgebra κ) : φ.symm (initialCollapseHom hk x) = value U (fun _ => x) := by
    apply φ.injective
    rw [OrderIso.apply_symm_apply]
    exact (collapseCompletionIso_constant U a hk hf hn ht hκ.isRegular hκ.aleph0_lt x).symm
  have hF_const (x : FirstAlgebra κ) :
      ultrapowerFirstStageHom U a hk hf hn ht (initialCollapseHom hk x) =
        value U (fun _ => Erdos1172LevyCohen.firstStageHom κ x) := by
    change scalarHom U (Erdos1172LevyCohen.firstStageHom κ) (φ.symm (initialCollapseHom hk x)) = _
    rw [hconst_φ x, scalarHom_value]
  have hcard_lt : #(q.length.toOrd.val.ToType) < κ := by
    rw [Cardinal.mk_toType]
    exact Cardinal.lt_ord.mp q.length.toOrd.property
  have hval_iInf (f : q.length.toOrd.val.ToType → Erdos1172LevyCohen.Algebra κ) :
      value U (fun _ => ⨅ j, f j) = ⨅ j, value U (fun _ => f j) := by
    apply compl_injective
    rw [← value_compl, compl_iInf, compl_iInf]
    exact (value_small_iSup U κ hcard_lt (fun _ j => (f j)ᶜ)).trans
      (iSup_congr fun j => value_compl U (fun _ => f j))
  unfold realizeCondition
  erw [← value_inf_eq U, hval_iInf]
  have hval_eq : value U (fun _ => Erdos1172LevyCohen.firstStageHom κ q.value) =
      ultrapowerFirstStageHom U a hk hf hn ht (initialLiftCoverCondition hk q).value :=
    (hF_const q.value).symm
  rw [hval_eq]
  apply congrArg (_ ⊓ ·)
  have hlen_ord : (initialLiftCoverCondition hk q).length.toOrd.val = q.length.toOrd.val :=
    initialCoordinate_ordinal hk q.length
  let eqv : q.length.toOrd.val.ToType ≃ (initialLiftCoverCondition hk q).length.toOrd.val.ToType :=
    ⟨fun j => Ordinal.ToType.mk ⟨j.toOrd.val,
        (show j.toOrd.val < q.length.toOrd.val from j.toOrd.property).trans_eq hlen_ord.symm⟩,
     fun j => Ordinal.ToType.mk ⟨j.toOrd.val,
        (show j.toOrd.val < (initialLiftCoverCondition hk q).length.toOrd.val from j.toOrd.property).trans_eq hlen_ord⟩,
     fun j => by
       let z := Ordinal.ToType.mk (o := (initialLiftCoverCondition hk q).length.toOrd.val)
         ⟨j.toOrd.val, (show j.toOrd.val < q.length.toOrd.val from j.toOrd.property).trans_eq hlen_ord.symm⟩
       have hz : z.toOrd.val = j.toOrd.val := congrArg Subtype.val (Ordinal.ToType.mk.symm_apply_apply _)
       apply Ordinal.ToType.mk.symm.injective
       exact (Ordinal.ToType.mk.symm_apply_apply _).trans (Subtype.ext hz),
     fun j => by
       let z := Ordinal.ToType.mk (o := q.length.toOrd.val)
         ⟨j.toOrd.val, (show j.toOrd.val < (initialLiftCoverCondition hk q).length.toOrd.val from j.toOrd.property).trans_eq hlen_ord⟩
       have hz : z.toOrd.val = j.toOrd.val := congrArg Subtype.val (Ordinal.ToType.mk.symm_apply_apply _)
       apply Ordinal.ToType.mk.symm.injective
       exact (Ordinal.ToType.mk.symm_apply_apply _).trans (Subtype.ext hz)⟩
  rw [← eqv.iInf_comp]
  apply iInf_congr
  intro j
  have heqv_ord : (eqv j).toOrd.val = j.toOrd.val :=
    congrArg Subtype.val (Ordinal.ToType.mk.symm_apply_apply _)
  have hbits_eq : (initialLiftCoverCondition hk q).bits (eqv j) = initialCollapseHom hk (q.bits j) := by
    dsimp only [initialLiftCoverCondition]
    apply congrArg (initialCollapseHom hk)
    apply congrArg q.bits
    apply Ordinal.ToType.mk.symm.injective
    exact (Ordinal.ToType.mk.symm_apply_apply _).trans (Subtype.ext heqv_ord)
  let k_j := StringName.includeIndex q.length.toOrd.property.le j
  have hinc_eq : StringName.includeIndex (initialLiftCoverCondition hk q).length.toOrd.property.le (eqv j) =
      initialCoordinate hk k_j := by
    apply Ordinal.ToType.mk.symm.injective
    exact Subtype.ext ((StringName.includeIndex_toOrd _ _).trans
      (heqv_ord.trans ((StringName.includeIndex_toOrd _ _).symm.trans (initialCoordinate_ordinal hk k_j).symm)))
  have hbit_const : value U (fun _ => levyCohenBit κ k_j) =
      ultrapowerLevyCohenBit U a (initialCoordinate hk k_j) := by
    unfold ultrapowerLevyCohenBit
    apply value_eq_of_eventuallyEq
    filter_upwards [ht, hf (initialCoordinate hk k_j), fiberEmbedding_fixed U a hk hf ht k_j]
      with i hti hmem hfix
    have hcond : Nonempty (κ.ord.ToType ≃o a i) ∧ initialCoordinate hk k_j ∈ a i := ⟨hti, hmem⟩
    rw [dif_pos hcond]
    let iso := Classical.choice hti
    have hiso_k : (iso k_j).val = initialCoordinate hk k_j := by
      simp only [fiberEmbedding, dif_pos hti] at hfix
      exact hfix
    have hsymm : iso.symm ⟨initialCoordinate hk k_j, hmem⟩ = k_j := by
      apply iso.injective
      rw [iso.apply_symm_apply]
      exact Subtype.ext hiso_k.symm
    rw [hsymm]
  rw [hbits_eq, hinc_eq, hF_const (q.bits j), ← hbit_const]
  exact (value_bitiff U _ _).symm

end UltrapowerRealization

section AnonymousUltrapowerHom

/-- `≤ κ`-ary well-founded Boolean terms over the `κ` binary decision generators. -/
inductive AnonTerm (κ : Cardinal.{u}) : Type u
  | bot : AnonTerm κ
  | bit : κ.ord.ToType → AnonTerm κ
  | compl : AnonTerm κ → AnonTerm κ
  | sup : (κ.ord.ToType → AnonTerm κ) → AnonTerm κ

/-- Evaluation of `AnonTerm κ` in `Erdos1172LevyCohen.Algebra κ`. -/
def AnonTerm.eval {κ : Cardinal.{u}} : AnonTerm κ → Erdos1172LevyCohen.Algebra κ
  | .bot => ⊥
  | .bit k => levyCohenBit κ k
  | .compl t => (eval t)ᶜ
  | .sup f => ⨆ m : κ.ord.ToType, eval (f m)

theorem AnonTerm.eval_mem {κ : Cardinal.{u}} (t : AnonTerm κ) :
    t.eval ∈ anonymousAlgebra κ := by
  induction t with
  | bot => exact bot_mem _
  | bit k => exact levyCohenBit_mem_anonymousAlgebra κ k
  | compl _ ih => exact compl_mem ih
  | sup f ih =>
    rw [AnonTerm.eval, ← sSup_range]
    exact sSup_mem (by rintro _ ⟨m, rfl⟩; exact ih m)

private theorem exists_mem_inf_ne_bot_of_sSup {α : Type u} [CompleteBooleanAlgebra α]
    {S : Set α} {c : α} (h : sSup S ⊓ c ≠ ⊥) : ∃ s ∈ S, s ⊓ c ≠ ⊥ := by
  by_contra hnone
  apply h
  rw [sSup_inf_eq]
  exact iSup₂_eq_bot.mpr fun s hs => by_contra fun hs_ne => hnone ⟨s, hs, hs_ne⟩

private theorem sInf_eq_compl_sSup_compl {α : Type u} [CompleteBooleanAlgebra α] (S : Set α) :
    sInf S = (sSup (Compl.compl '' S))ᶜ := by
  apply compl_injective
  rw [compl_compl, compl_sInf, sSup_image]

/-- For inaccessible `κ`, every element of `anonymousAlgebra κ` is the evaluation of an `AnonTerm κ`. -/
theorem range_anonTerm_eval (κ : Cardinal.{u}) (hκ : κ.IsInaccessible) :
    Set.range (AnonTerm.eval (κ := κ)) = (anonymousAlgebra κ : Set (Erdos1172LevyCohen.Algebra κ)) := by
  classical
  apply Set.Subset.antisymm
  · rintro _ ⟨t, rfl⟩
    exact t.eval_mem
  · obtain ⟨D, hDsize, hDdense⟩ := exists_dense_presentation κ hκ
    have hsSup_closed (S : Set (Erdos1172LevyCohen.Algebra κ))
        (hS : S ⊆ Set.range (AnonTerm.eval (κ := κ))) :
        sSup S ∈ Set.range (AnonTerm.eval (κ := κ)) := by
      let D' := {d : D // ∃ s ∈ S, condition d.val ≤ s}
      by_cases hne : Nonempty D'
      · have hcard : #D' ≤ #(κ.ord.ToType) := by
          rw [Cardinal.mk_ord_toType]
          exact (Cardinal.mk_subtype_le _).trans hDsize
        obtain ⟨emb⟩ : Nonempty (D' ↪ κ.ord.ToType) := hcard
        let surj : κ.ord.ToType → D' := Function.invFun emb
        have hsurj : Function.Surjective surj := (Function.leftInverse_invFun emb.injective).surjective
        choose pickS hpick_mem hpick_le using fun d : D' => d.property
        choose pickT hpickT using fun d : D' => hS (hpick_mem d)
        refine ⟨.sup (fun m => pickT (surj m)), ?_⟩
        change (⨆ m : κ.ord.ToType, (pickT (surj m)).eval) = sSup S
        simp_rw [hpickT]
        have hsup_surj : (⨆ m : κ.ord.ToType, pickS (surj m)) = ⨆ d : D', pickS d :=
          le_antisymm (iSup_le fun m => le_iSup pickS (surj m))
            (iSup_le fun d => by obtain ⟨m, rfl⟩ := hsurj d; exact le_iSup (fun m => pickS (surj m)) m)
        rw [hsup_surj]
        apply le_antisymm (iSup_le fun d => le_sSup (hpick_mem d))
        by_contra hnot
        have hdiff : sSup S ⊓ (⨆ d : D', pickS d)ᶜ ≠ ⊥ := fun h0 =>
          hnot (disjoint_compl_right_iff.mp (disjoint_iff.mpr h0))
        obtain ⟨s₀, hs₀_mem, hs₀_ne⟩ := exists_mem_inf_ne_bot_of_sSup hdiff
        obtain ⟨p, hp⟩ := exists_condition_le hs₀_ne
        obtain ⟨d₀, hd₀D, hd₀p⟩ := hDdense p
        have hd₀_s₀ : condition d₀ ≤ s₀ := (condition_mono hd₀p).trans (hp.trans inf_le_left)
        let d' : D' := ⟨⟨d₀, hd₀D⟩, s₀, hs₀_mem, hd₀_s₀⟩
        have h1 : condition d₀ ≤ ⨆ d : D', pickS d := (hpick_le d').trans (le_iSup pickS d')
        have h2 : condition d₀ ≤ (⨆ d : D', pickS d)ᶜ :=
          (condition_mono hd₀p).trans (hp.trans inf_le_right)
        exact condition_ne_bot d₀ (le_bot_iff.mp ((le_inf h1 h2).trans inf_compl_eq_bot.le))
      · have hemp : IsEmpty D' := not_nonempty_iff.mp hne
        have hbot : sSup S = ⊥ := by
          by_contra hne_bot
          have hex_s : ∃ s ∈ S, s ≠ ⊥ := by
            by_contra hnone
            exact hne_bot (sSup_eq_bot.mpr fun s hs => by_contra fun hs_ne => hnone ⟨s, hs, hs_ne⟩)
          obtain ⟨s₀, hs₀_mem, hs₀_ne⟩ := hex_s
          obtain ⟨p, hp⟩ := exists_condition_le hs₀_ne
          obtain ⟨d₀, hd₀D, hd₀p⟩ := hDdense p
          exact hemp.false ⟨⟨d₀, hd₀D⟩, s₀, hs₀_mem, (condition_mono hd₀p).trans hp⟩
        exact ⟨.bot, hbot.symm⟩
    have hcompl_closed {x : Erdos1172LevyCohen.Algebra κ}
        (hx : x ∈ Set.range (AnonTerm.eval (κ := κ))) :
        xᶜ ∈ Set.range (AnonTerm.eval (κ := κ)) := by
      obtain ⟨t, rfl⟩ := hx
      exact ⟨.compl t, rfl⟩
    let R_sub : CompleteSubalgebra (Erdos1172LevyCohen.Algebra κ) :=
      { toCompleteSublattice := CompleteSublattice.mk'
          (Set.range (AnonTerm.eval (κ := κ)))
          hsSup_closed
          (fun S hS => by
            have himg : Compl.compl '' S ⊆ Set.range (AnonTerm.eval (κ := κ)) := by
              rintro _ ⟨x, hx, rfl⟩
              exact hcompl_closed (hS hx)
            rw [sInf_eq_compl_sSup_compl S]
            exact hcompl_closed (hsSup_closed _ himg))
        compl_mem' := hcompl_closed }
    have hle : anonymousAlgebra κ ≤ R_sub := by
      rw [anonymousAlgebra_le_iff κ R_sub]
      intro i
      obtain ⟨α, hα, heq⟩ := PSet.mem_ordinalMk_iff.mp (PSet.func_mem (PSet.ordinalMk κ.ord) i)
      let k : κ.ord.ToType := Ordinal.ToType.mk ⟨α, hα⟩
      have hk_ord : k.toOrd.val = α := congrArg Subtype.val (Ordinal.ToType.mk.symm_apply_apply _)
      have hpeq : PSet.Equiv ((PSet.ordinalMk κ.ord).Func i) (PSet.ordinalMk k.toOrd.val) :=
        PSet.Equiv.trans heq (PSet.equiv_iff_eq.mpr (congrArg Ordinal.toZFSet hk_ord.symm))
      have hchk : (⊤ : FirstAlgebra κ) ≤
          check ((PSet.ordinalMk κ.ord).Func i) =ᴮ check (PSet.ordinalMk k.toOrd.val) :=
        check_bv_eq hpeq
      have hbit : Erdos1172CohenIteration.bitValue (omegaOne : bSet (FirstAlgebra κ))
            (check ((PSet.ordinalMk κ.ord).Func i)) 1 = levyCohenBit κ k := by
        unfold levyCohenBit Erdos1172CohenIteration.bitValue
        apply le_antisymm
        · refine iSup_le fun ⟨p, hp⟩ => Erdos1172CohenIteration.condition_le_bitValue ?_
          exact mem_congr (pair_congr (le_top.trans hchk) bv_refl) bv_refl hp
        · refine iSup_le fun ⟨p, hp⟩ => Erdos1172CohenIteration.condition_le_bitValue ?_
          exact mem_congr (pair_congr (le_top.trans (bv_symm hchk)) bv_refl) bv_refl hp
      exact ⟨.bit k, hbit.symm⟩
    exact hle

def ImmediateSubterm {κ : Cardinal.{u}} (s t : AnonTerm κ) : Prop :=
  t = .compl s ∨ ∃ f : κ.ord.ToType → AnonTerm κ, t = .sup f ∧ ∃ m, f m = s

private theorem immediateSubterm_wf {κ : Cardinal.{u}} :
    WellFounded (ImmediateSubterm (κ := κ)) := by
  constructor
  intro t
  induction t with
  | bot =>
    constructor
    rintro s (h | ⟨_, h, _⟩) <;> cases h
  | bit _ =>
    constructor
    rintro s (h | ⟨_, h, _⟩) <;> cases h
  | compl t ih =>
    constructor
    rintro s (h | ⟨_, h, _⟩)
    · cases h
      exact ih
    · cases h
  | sup f ih =>
    constructor
    rintro s (h | ⟨g, h, m, rfl⟩)
    · cases h
    · cases h
      exact ih m

def EventuallySubterm {I : Type u} {κ : Cardinal.{u}} (U : Ultrafilter I)
    (S T : I → AnonTerm κ) : Prop :=
  ∀ᶠ i in U, ImmediateSubterm (S i) (T i)

private theorem eventuallySubterm_wf {I : Type u} {κ : Cardinal.{u}} (U : Ultrafilter I)
    [CountableInterFilter (U : Filter I)] :
    WellFounded (EventuallySubterm (κ := κ) U) := by
  apply wellFounded_iff_isEmpty_descending_chain.mpr
  constructor
  rintro ⟨c, hc⟩
  have hall : ∀ᶠ i in U, ∀ n : ℕ, ImmediateSubterm (c (n + 1) i) (c n i) :=
    eventually_countable_forall.mpr hc
  obtain ⟨i₀, hi₀⟩ := hall.exists
  exact (wellFounded_iff_isEmpty_descending_chain.mp immediateSubterm_wf).false
    ⟨fun n => c n i₀, hi₀⟩

variable {I : Type u} {κ θ : Cardinal.{u}} (U : Ultrafilter I) (a : I → Set θ.ord.ToType)
variable [CountableInterFilter (U : Filter I)] [Nonempty θ.ord.ToType]
variable (hk : κ ≤ θ) (hf : FineOn U a) (hn : NormalOn U a) (ht : FiberOrderType U κ θ a)

include hk hf hn ht in
private theorem levyCohenUltrapowerIso_term_mem (hκ : κ.IsInaccessible) (hθ : θ.IsInaccessible)
    (T : I → AnonTerm κ) :
    levyCohenUltrapowerIso U a hk hf hn ht hκ hθ (value U (fun i => (T i).eval)) ∈
      anonymousAlgebra θ := by
  classical
  let ψ : CompleteLatticeHom
      (Erdos1172BooleanUltrapower.Algebra U (Erdos1172LevyCohen.Algebra κ))
      (Erdos1172LevyCohen.Algebra θ) :=
    CompleteLatticeHom.OrderIso.toCompleteLatticeHom (levyCohenUltrapowerIso U a hk hf hn ht hκ hθ)
  change ψ (value U (fun i => (T i).eval)) ∈ anonymousAlgebra θ
  induction T using (eventuallySubterm_wf U).induction with
  | h T ih =>
    let isBot : Set I := {i | T i = .bot}
    let isBit : Set I := {i | ∃ k, T i = .bit k}
    let isCompl : Set I := {i | ∃ s, T i = .compl s}
    let isSup : Set I := {i | ∃ f, T i = .sup f}
    have hcov : isBot ∪ isBit ∪ isCompl ∪ isSup = Set.univ := by
      ext i
      simp only [isBot, isBit, isCompl, isSup, Set.mem_union, Set.mem_ofPred_eq, Set.mem_univ, iff_true]
      cases T i with
      | bot => exact Or.inl (Or.inl (Or.inl rfl))
      | bit k => exact Or.inl (Or.inl (Or.inr ⟨k, rfl⟩))
      | compl s => exact Or.inl (Or.inr ⟨s, rfl⟩)
      | sup f => exact Or.inr ⟨f, rfl⟩
    have huniv : isBot ∪ isBit ∪ isCompl ∪ isSup ∈ U := hcov ▸ Filter.univ_mem
    rcases (Ultrafilter.union_mem_iff.mp huniv) with h123 | hSup
    · rcases (Ultrafilter.union_mem_iff.mp h123) with h12 | hCompl
      · rcases (Ultrafilter.union_mem_iff.mp h12) with hBot | hBit
        · have hev : (fun i => (T i).eval) =ᶠ[U] fun _ => ⊥ :=
            Filter.eventually_iff_exists_mem.mpr ⟨isBot, hBot, fun i hi => by
              change (T i).eval = ⊥
              rw [show T i = .bot from hi]
              rfl⟩
          rw [value_eq_of_eventuallyEq U hev, value_bot, BotHomClass.map_bot]
          exact bot_mem _
        · have hev_bit : ∀ᶠ i in U, ∃ k, T i = .bit k := hBit
          let defaultK : κ.ord.ToType := Ordinal.ToType.mk ⟨0, hκ.isRegular.ord_pos⟩
          let k_of (i : I) : κ.ord.ToType := if h : ∃ k, T i = .bit k then h.choose else defaultK
          have hT_eq : ∀ᶠ i in U, T i = .bit (k_of i) := hev_bit.mono fun i hi => by
            simp only [k_of, dif_pos hi]
            exact hi.choose_spec
          have hk_in : ∀ᶠ i in U, fiberEmbedding a hk i (k_of i) ∈ a i :=
            (fiber_range U a hk ht).mono fun i hri => hri ▸ Set.mem_range_self _
          obtain ⟨ξ, hξ⟩ := hn (fun i => fiberEmbedding a hk i (k_of i)) hk_in
          have hval_eq : value U (fun i => (T i).eval) = ultrapowerLevyCohenBit U a ξ := by
            unfold ultrapowerLevyCohenBit
            apply value_eq_of_eventuallyEq
            filter_upwards [hT_eq, ht, hf ξ, hξ] with i hTi hti hξ_mem hξ_eq
            have hcond : Nonempty (κ.ord.ToType ≃o a i) ∧ ξ ∈ a i := ⟨hti, hξ_mem⟩
            let iso := Classical.choice hti
            have hiso_k : (iso (k_of i)).val = ξ := by
              simp only [fiberEmbedding, dif_pos hti] at hξ_eq
              exact hξ_eq
            have hsymm : iso.symm ⟨ξ, hξ_mem⟩ = k_of i := by
              apply iso.injective
              rw [iso.apply_symm_apply]
              exact Subtype.ext hiso_k.symm
            change (T i).eval = _
            rw [hTi, AnonTerm.eval, dif_pos hcond, hsymm]
          rw [hval_eq]
          change levyCohenUltrapowerIso U a hk hf hn ht hκ hθ (ultrapowerLevyCohenBit U a ξ) ∈ _
          rw [levyCohenUltrapowerIso_bit U a hk hf hn ht hκ hθ ξ]
          exact levyCohenBit_mem_anonymousAlgebra θ ξ
      · have hev_c : ∀ᶠ i in U, ∃ s, T i = .compl s := hCompl
        let S (i : I) : AnonTerm κ := if h : ∃ s, T i = .compl s then h.choose else .bot
        have hT_eq : ∀ᶠ i in U, T i = .compl (S i) := hev_c.mono fun i hi => by
          simp only [S, dif_pos hi]
          exact hi.choose_spec
        have hsub : EventuallySubterm U S T := hT_eq.mono fun _ hi => Or.inl hi
        have hev_eval : (fun i => (T i).eval) =ᶠ[U] fun i => (S i).evalᶜ :=
          hT_eq.mono fun i hi => by
            change (T i).eval = (S i).evalᶜ
            rw [hi]
            rfl
        rw [value_eq_of_eventuallyEq U hev_eval, value_compl, map_compl' ψ]
        exact compl_mem (ih S hsub)
    · have hev_s : ∀ᶠ i in U, ∃ f, T i = .sup f := hSup
      let F_of (i : I) : κ.ord.ToType → AnonTerm κ :=
        if h : ∃ f, T i = .sup f then h.choose else fun _ => .bot
      have hT_eq : ∀ᶠ i in U, T i = .sup (F_of i) := hev_s.mono fun i hi => by
        simp only [F_of, dif_pos hi]
        exact hi.choose_spec
      let S_ξ (ξ : θ.ord.ToType) (i : I) : AnonTerm κ :=
        if h : Nonempty (κ.ord.ToType ≃o a i) ∧ ξ ∈ a i then
          F_of i ((Classical.choice h.1).symm ⟨ξ, h.2⟩)
        else .bot
      have hsub_ξ (ξ : θ.ord.ToType) : EventuallySubterm U (S_ξ ξ) T := by
        filter_upwards [hT_eq, ht, hf ξ] with i hTi hti hξ_mem
        have hcond : Nonempty (κ.ord.ToType ≃o a i) ∧ ξ ∈ a i := ⟨hti, hξ_mem⟩
        simp only [S_ξ, dif_pos hcond]
        exact Or.inr ⟨F_of i, hTi, _, rfl⟩
      have hval_sup : value U (fun i => (T i).eval) =
          ⨆ ξ : θ.ord.ToType, value U (fun i => (S_ξ ξ i).eval) := by
        rw [← value_fine_iSup U a hf hn (Function.Embedding.refl _) (fun ξ i => (S_ξ ξ i).eval)]
        apply value_eq_of_eventuallyEq
        filter_upwards [hT_eq, ht] with i hTi hti
        rw [hTi, AnonTerm.eval]
        let iso := Classical.choice hti
        apply le_antisymm
        · refine iSup_le fun m => ?_
          let ξ := (iso m).val
          have hξ_mem : ξ ∈ a i := (iso m).property
          have hcond : Nonempty (κ.ord.ToType ≃o a i) ∧ ξ ∈ a i := ⟨hti, hξ_mem⟩
          have hsymm : iso.symm ⟨ξ, hξ_mem⟩ = m := iso.symm_apply_apply m
          refine (le_iSup (fun s : {s : θ.ord.ToType // s ∈ a i} => (S_ξ s.val i).eval) ⟨ξ, hξ_mem⟩).trans_eq' ?_
          dsimp only [S_ξ]
          rw [dif_pos hcond]
          exact congrArg (fun k => (F_of i k).eval) hsymm
        · refine iSup_le fun ⟨ξ, hξ_mem⟩ => ?_
          have hcond : Nonempty (κ.ord.ToType ≃o a i) ∧ ξ ∈ a i := ⟨hti, hξ_mem⟩
          simp only [S_ξ, dif_pos hcond]
          exact le_iSup (fun m => (F_of i m).eval) _
      rw [hval_sup, _root_.map_iSup ψ, ← sSup_range]
      exact sSup_mem (by rintro _ ⟨ξ, rfl⟩; exact ih (S_ξ ξ) (hsub_ξ ξ))

include hk hf hn ht in
theorem levyCohenUltrapowerIso_scalar_mem (hκ : κ.IsInaccessible) (hθ : θ.IsInaccessible)
    (x : Erdos1172BooleanUltrapower.Algebra U (anonymousAlgebra κ)) :
    levyCohenUltrapowerIso U a hk hf hn ht hκ hθ
      (scalarHom U (inclusion (anonymousAlgebra κ)) x) ∈ anonymousAlgebra θ := by
  classical
  let ι := inclusion (anonymousAlgebra κ)
  let ψ : CompleteLatticeHom
      (Erdos1172BooleanUltrapower.Algebra U (Erdos1172LevyCohen.Algebra κ))
      (Erdos1172LevyCohen.Algebra θ) :=
    CompleteLatticeHom.OrderIso.toCompleteLatticeHom (levyCohenUltrapowerIso U a hk hf hn ht hκ hθ)
  let P := {p : Positive (Germ (U : Filter I) (anonymousAlgebra κ)) // condition p ≤ x}
  have hx_eq : x = ⨆ p : P, condition p.val :=
    le_antisymm (fun q hq => condition_le_iff.mp
      (le_iSup (fun p : P => condition p.val) ⟨q, condition_le_iff.mpr hq⟩))
      (iSup_le fun p => p.property)
  change ψ (scalarHom U ι x) ∈ anonymousAlgebra θ
  rw [hx_eq, _root_.map_iSup (scalarHom U ι), _root_.map_iSup ψ, ← sSup_range]
  apply sSup_mem
  rintro _ ⟨p, rfl⟩
  obtain ⟨f, hf_eq⟩ : ∃ f : I → anonymousAlgebra κ, Germ.ofFun f = p.val.val :=
    Germ.inductionOn p.val.val fun f => ⟨f, rfl⟩
  have hcond_eq : condition p.val = value U f := by
    apply le_antisymm
    · exact condition_le_iff.mpr (show p.val.val ≤ Germ.ofFun f from hf_eq.symm.le)
    · intro q hq
      exact (mem_condition_iff p.val q).mpr fun r hr =>
        ⟨r, le_rfl, (show r.val ≤ q.val from hr).trans ((show q.val ≤ Germ.ofFun f from hq).trans hf_eq.le)⟩
  choose T hT using fun i : I => by
    have hm : (f i : Erdos1172LevyCohen.Algebra κ) ∈ Set.range (AnonTerm.eval (κ := κ)) := by
      rw [range_anonTerm_eval κ hκ]
      exact (f i).property
    exact hm
  change ψ (scalarHom U ι (condition p.val)) ∈ anonymousAlgebra θ
  rw [hcond_eq, scalarHom_value]
  have hfn : (fun i => ι (f i)) = fun i => (T i).eval := funext fun i => (hT i).symm
  rw [hfn]
  exact levyCohenUltrapowerIso_term_mem U a hk hf hn ht hκ hθ T

/-- Complete Boolean homomorphism `Algebra U (anonymousAlgebra κ) → anonymousAlgebra θ`
induced by `levyCohenUltrapowerIso`. -/
def anonymousUltrapowerHom (hκ : κ.IsInaccessible) (hθ : θ.IsInaccessible) :
    CompleteLatticeHom (Erdos1172BooleanUltrapower.Algebra U (anonymousAlgebra κ))
      (anonymousAlgebra θ) where
  toFun x := ⟨levyCohenUltrapowerIso U a hk hf hn ht hκ hθ
      (scalarHom U (inclusion (anonymousAlgebra κ)) x),
    levyCohenUltrapowerIso_scalar_mem U a hk hf hn ht hκ hθ x⟩
  map_sSup' S := by
    let ψ : CompleteLatticeHom
        (Erdos1172BooleanUltrapower.Algebra U (Erdos1172LevyCohen.Algebra κ))
        (Erdos1172LevyCohen.Algebra θ) :=
      CompleteLatticeHom.OrderIso.toCompleteLatticeHom (levyCohenUltrapowerIso U a hk hf hn ht hκ hθ)
    apply Subtype.ext
    change ψ (scalarHom U (inclusion (anonymousAlgebra κ)) (sSup S)) =
      inclusion (anonymousAlgebra θ) (sSup _)
    rw [sSupHomClass.map_sSup, sSupHomClass.map_sSup, inclusion_sSup, Set.image_image, Set.image_image]
    rfl
  map_sInf' S := by
    let ψ : CompleteLatticeHom
        (Erdos1172BooleanUltrapower.Algebra U (Erdos1172LevyCohen.Algebra κ))
        (Erdos1172LevyCohen.Algebra θ) :=
      CompleteLatticeHom.OrderIso.toCompleteLatticeHom (levyCohenUltrapowerIso U a hk hf hn ht hκ hθ)
    apply Subtype.ext
    change ψ (scalarHom U (inclusion (anonymousAlgebra κ)) (sInf S)) =
      inclusion (anonymousAlgebra θ) (sInf _)
    rw [sInfHomClass.map_sInf, sInfHomClass.map_sInf, inclusion_sInf, Set.image_image, Set.image_image]
    rfl

theorem inclusion_anonymousUltrapowerHom (hκ : κ.IsInaccessible) (hθ : θ.IsInaccessible)
    (x : Erdos1172BooleanUltrapower.Algebra U (anonymousAlgebra κ)) :
    inclusion (anonymousAlgebra θ) (anonymousUltrapowerHom U a hk hf hn ht hκ hθ x) =
      levyCohenUltrapowerIso U a hk hf hn ht hκ hθ
        (scalarHom U (inclusion (anonymousAlgebra κ)) x) := rfl

include hk hf hn ht in
/-- `anonymousUltrapowerHom` maps the bounded ultrapower lift of `anonymousSubset κ` to
`anonymousSubset θ` at `⊤`. -/
theorem anonymousUltrapowerHom_subset (hκ : κ.IsInaccessible) (hθ : θ.IsInaccessible) :
    (⊤ : anonymousAlgebra θ) ≤
      mapNames (anonymousUltrapowerHom U a hk hf hn ht hκ hθ)
        (boundedAnonName U a (fun _ => anonymousSubset κ)) =ᴮ anonymousSubset θ := by
  classical
  let j_anon := anonymousUltrapowerHom U a hk hf hn ht hκ hθ
  let VA := Erdos1172BooleanUltrapower.Algebra U (anonymousAlgebra κ)
  have hord_θ : ordinalImage U a κ.ord = θ.ord :=
    Ordinal.toZFSet_injective ((ordinalImage_code U a κ.ord).trans
      (boundedDiagonal_critical_image U κ θ a hf hn ht))
  have hsub_VA : (⊤ : VA) ≤
      boundedAnonName U a (fun _ => anonymousSubset κ) ⊆ᴮ check (PSet.ordinalMk θ.ord) := by
    have h1 : (⊤ : VA) ≤
        boundedAnonName U a (fun _ => anonymousSubset κ) ⊆ᴮ
          boundedAnonName U a (fun _ => check (PSet.ordinalMk κ.ord)) := by
      rw [← boundedAnonName_subset U a hk hf hn ht hκ _ _ (Supported.const _) (Supported.const _),
        ← value_top U]
      exact (value_le_value_iff U).mpr (Eventually.of_forall fun _ => anonymousSubset_subset κ)
    have h2 := boundedAnon_ordinal U a hk hf hn ht hκ κ.ord
    rw [hord_θ] at h2
    exact subset_trans' h1 (subset_of_eq h2)
  have hsub_lhs : (⊤ : anonymousAlgebra θ) ≤
      mapNames j_anon (boundedAnonName U a (fun _ => anonymousSubset κ)) ⊆ᴮ
        check (PSet.ordinalMk θ.ord) := by
    simpa only [TopHomClass.map_top, map_subset, map_check] using OrderHomClass.mono j_anon hsub_VA
  have hsub_rhs : (⊤ : anonymousAlgebra θ) ≤ anonymousSubset θ ⊆ᴮ check (PSet.ordinalMk θ.ord) :=
    anonymousSubset_subset θ
  have hbit_eq (k : (PSet.ordinalMk θ.ord).Type) :
      (check ((PSet.ordinalMk θ.ord).Func k) ∈ᴮ
        mapNames j_anon (boundedAnonName U a (fun _ => anonymousSubset κ))) =
      (check ((PSet.ordinalMk θ.ord).Func k) ∈ᴮ anonymousSubset θ) := by
    apply inclusion_injective (anonymousAlgebra θ)
    let ιθ := inclusion (anonymousAlgebra θ)
    let ικ := inclusion (anonymousAlgebra κ)
    obtain ⟨α, hα, heq⟩ := PSet.mem_ordinalMk_iff.mp (PSet.func_mem (PSet.ordinalMk θ.ord) k)
    let ξ : θ.ord.ToType := Ordinal.ToType.mk ⟨α, hα⟩
    have hξ_ord : ξ.toOrd.val = α := congrArg Subtype.val (Ordinal.ToType.mk.symm_apply_apply _)
    have hpeq : PSet.Equiv ((PSet.ordinalMk θ.ord).Func k) (PSet.ordinalMk ξ.toOrd.val) :=
      PSet.Equiv.trans heq (PSet.equiv_iff_eq.mpr (congrArg Ordinal.toZFSet hξ_ord.symm))
    have hchk_Aθ : (⊤ : anonymousAlgebra θ) ≤
        check ((PSet.ordinalMk θ.ord).Func k) =ᴮ check (PSet.ordinalMk ξ.toOrd.val) :=
      check_bv_eq hpeq
    have hlhs_ξ : (check ((PSet.ordinalMk θ.ord).Func k) ∈ᴮ
        mapNames j_anon (boundedAnonName U a (fun _ => anonymousSubset κ))) =
        j_anon (check (PSet.ordinalMk ξ.toOrd.val) ∈ᴮ
          boundedAnonName U a (fun _ => anonymousSubset κ)) := by
      have h1 := bv_rw (top_unique hchk_Aθ)
        (fun z => z ∈ᴮ mapNames j_anon (boundedAnonName U a (fun _ => anonymousSubset κ)))
        (h_congr := B_ext_mem_left)
      rw [← h1, ← map_check j_anon, ← map_mem j_anon]
    have hrhs_ξ : ιθ (check ((PSet.ordinalMk θ.ord).Func k) ∈ᴮ anonymousSubset θ) =
        levyCohenBit θ ξ := by
      have h1 := bv_rw (top_unique hchk_Aθ) (fun z => z ∈ᴮ anonymousSubset θ) (h_congr := B_ext_mem_left)
      rw [← h1, map_mem ιθ, map_check ιθ]
      have h2 := bv_rw (top_unique (bv_symm (anonymousSubset_recovers θ)))
        (fun z => (check (PSet.ordinalMk ξ.toOrd.val) : bSet (Erdos1172LevyCohen.Algebra θ)) ∈ᴮ z)
        (h_congr := B_ext_mem_right)
      rw [← h2, ← levyCohenBit_eq_mem_cohenSubset]
    rw [hlhs_ξ, hrhs_ξ, inclusion_anonymousUltrapowerHom]
    let F_ξ (i : I) : PSet.{u} := PSet.ordinalMk (typeLT ↥(boundedFiber θ a ξ i))
    have hF_supp : Supported U a F_ξ := ⟨ξ, fun S => PSet.ordinalMk (typeLT ↥S), EventuallyEq.rfl⟩
    let w_ξ : BoundedHull U θ a := ⟨fineRankGerm U κ θ a ξ, fineRankGerm_boundedSupport U κ θ a ξ hf ht⟩
    have hw_val : Germ.ofFun (fun i => ZFSet.mk (F_ξ i)) = w_ξ.val := by
      change Germ.ofFun (fun i => (typeLT ↥(a i ∩ Set.Iio ξ)).toZFSet) = fineRankGerm U κ θ a ξ
      exact (fineRankGerm_eq_prefix U κ θ a ξ hf ht).symm
    have hw_col : boundedCollapse U θ a w_ξ = ξ.toOrd.val.toZFSet := by
      apply boundedCollapse_ordinal_agrees U θ a ξ.toOrd.val
      · intro β hβ
        let η := Ordinal.ToType.mk (⟨β, hβ.trans ξ.toOrd.property⟩ : Set.Iio θ.ord)
        refine ⟨⟨fineRankGerm U κ θ a η, fineRankGerm_boundedSupport U κ θ a η hf ht⟩, ?_⟩
        exact (collapse_fineRankGerm U κ θ a hf hn ht η).trans
          (congrArg (fun z : Set.Iio θ.ord => z.val.toZFSet) (Ordinal.ToType.mk.symm_apply_apply _))
      · exact collapse_fineRankGerm U κ θ a hf hn ht ξ
    have hF_chk : (⊤ : VA) ≤ boundedAnonName U a (fun i => check (F_ξ i)) =ᴮ
        check (PSet.ordinalMk ξ.toOrd.val) :=
      bv_trans (boundedAnon_checked_family U a hk hf hn ht hκ w_ξ F_ξ hF_supp hw_val)
        (check_bv_eq (PSet.equiv_iff_eq.mpr ((ZFSet.mk_out _).trans hw_col)))
    have hmem_VA : (check (PSet.ordinalMk ξ.toOrd.val) ∈ᴮ
        boundedAnonName U a (fun _ => anonymousSubset κ)) =
        value U (fun i => (check (F_ξ i) : bSet (anonymousAlgebra κ)) ∈ᴮ anonymousSubset κ) := by
      rw [bv_rw (top_unique hF_chk) (fun z => z ∈ᴮ boundedAnonName U a (fun _ => anonymousSubset κ))
        (h_congr := B_ext_mem_left)]
      exact (boundedAnonName_mem U a hk hf hn ht hκ _ _ (hF_supp.map check) (Supported.const _)).symm
    rw [hmem_VA, scalarHom_value]
    have hval_bit : value U (fun i => ικ ((check (F_ξ i) : bSet (anonymousAlgebra κ)) ∈ᴮ anonymousSubset κ)) =
        ultrapowerLevyCohenBit U a ξ := by
      unfold ultrapowerLevyCohenBit
      apply value_eq_of_eventuallyEq
      filter_upwards [ht, hf ξ, Germ.coe_eq.mp (fineRankGerm_eq_prefix U κ θ a ξ hf ht)]
        with i hti hξ_mem hpref
      have hcond : Nonempty (κ.ord.ToType ≃o a i) ∧ ξ ∈ a i := ⟨hti, hξ_mem⟩
      rw [dif_pos hcond]
      let k_i := (Classical.choice hti).symm ⟨ξ, hξ_mem⟩
      have hpref' : (if h : Nonempty (κ.ord.ToType ≃o a i) ∧ ξ ∈ a i then
          ((Classical.choice h.1).symm ⟨ξ, h.2⟩).toOrd.val.toZFSet else ∅) =
          (typeLT ↥(a i ∩ Set.Iio ξ)).toZFSet := hpref
      rw [dif_pos hcond] at hpref'
      have htype_eq : typeLT ↥(boundedFiber θ a ξ i) = k_i.toOrd.val :=
        (Ordinal.toZFSet_injective hpref').symm
      have hF_eq : F_ξ i = PSet.ordinalMk k_i.toOrd.val := congrArg PSet.ordinalMk htype_eq
      rw [hF_eq, map_mem ικ, map_check ικ]
      have hrec := bv_rw (top_unique (bv_symm (anonymousSubset_recovers κ)))
        (fun z => (check (PSet.ordinalMk k_i.toOrd.val) : bSet (Erdos1172LevyCohen.Algebra κ)) ∈ᴮ z)
        (h_congr := B_ext_mem_right)
      rw [← hrec, ← levyCohenBit_eq_mem_cohenSubset]
    rw [hval_bit, levyCohenUltrapowerIso_bit U a hk hf hn ht hκ hθ ξ]
  have rep (Y : bSet (anonymousAlgebra θ))
      (sub : (⊤ : anonymousAlgebra θ) ≤ Y ⊆ᴮ check (PSet.ordinalMk θ.ord)) :
      (⊤ : anonymousAlgebra θ) ≤ Y =ᴮ
        ErdosCheckedIndicator.checkedIndicator (PSet.ordinalMk θ.ord)
          (fun k => check ((PSet.ordinalMk θ.ord).Func k) ∈ᴮ Y) := by
    rw [ErdosCheckedIndicator.checkedIndicator_membership_eq]
    exact eq_membership_indicator_of_subset sub
  have h1 := rep (mapNames j_anon (boundedAnonName U a (fun _ => anonymousSubset κ))) hsub_lhs
  simp_rw [hbit_eq] at h1
  exact bv_trans h1 (bv_symm (rep (anonymousSubset θ) hsub_rhs))

end AnonymousUltrapowerHom

