module

public import Erdos1172.Part4LevyCohenIteration
public import Erdos1172.Part4CohenSubsetName

@[expose] public section

/-!
# The actual membership-generated algebra of the collapse--Cohen subset

The ambient forcing is the constructed dependent iteration, and its subset
coefficients are suprema of actual decision cones. The smaller algebra is
the complete subalgebra generated by those membership values. A name over
that smaller algebra transports back to the ambient subset at top.

For regular uncountable κ every ground coordinate is covered by the two
actual binary decisions. This does not assert second-stage preservation of
omega-one or full GCH, quotient distributivity, genericity for arbitrary
dense sets, an embedding lift, or existence of the required normal ideal.
-/

set_option autoImplicit false

noncomputable section

open scoped Flypitch

universe u

namespace Erdos1172LevyCohen

open bSet Erdos1172CompleteSubalgebra

/-- The subset with the actual one-decision coefficients of the iteration. -/
def cohenSubset (κ : Cardinal.{u}) : bSet (Algebra κ) :=
  Erdos1172CohenIteration.subsetName (B := FirstAlgebra κ) (PSet.ordinalMk κ.ord)

/-- Complete generation by the membership values of the constructed subset. -/
def anonymousAlgebra (κ : Cardinal.{u}) : CompleteSubalgebra (Algebra κ) :=
  Erdos1172CohenIteration.generatedAlgebra (B := FirstAlgebra κ)
    (PSet.ordinalMk κ.ord)

/-- The subset as a name over the generated complete subalgebra itself. -/
def anonymousSubset (κ : Cardinal.{u}) : bSet (anonymousAlgebra κ) :=
  Erdos1172CohenIteration.generatedName (B := FirstAlgebra κ)
    (PSet.ordinalMk κ.ord)

theorem cohenSubset_subset (κ : Cardinal.{u}) :
    (⊤ : Algebra κ) ≤ cohenSubset κ ⊆ᴮ check (PSet.ordinalMk κ.ord) :=
  Erdos1172CohenIteration.subsetName_subset (PSet.ordinalMk κ.ord)

theorem cohenSubset_member_eq_bitValue (κ : Cardinal.{u})
    (i : (PSet.ordinalMk κ.ord).Type) :
    (check ((PSet.ordinalMk κ.ord).Func i) : bSet (Algebra κ)) ∈ᴮ cohenSubset κ =
      Erdos1172CohenIteration.bitValue (ErdosOmegaTwo.omegaOne : bSet (FirstAlgebra κ))
        (check ((PSet.ordinalMk κ.ord).Func i)) (1 : bSet (FirstAlgebra κ)) :=
  Erdos1172CohenIteration.subsetName_member_eq_bitValue (PSet.ordinalMk_inj κ.ord) i

/-- Coverage is proved using the first-stage identification of checked κ,
not an assumed identification with the second-stage internal omega-one. -/
theorem coordinate_binary_coverage (κ : Cardinal.{u})
    (Hκ : κ.IsRegular) (Hunc : Cardinal.aleph0 < κ)
    (i : (PSet.ordinalMk κ.ord).Type) :
    Erdos1172CohenIteration.bitValue (ErdosOmegaTwo.omegaOne : bSet (FirstAlgebra κ))
        (check ((PSet.ordinalMk κ.ord).Func i)) (0 : bSet (FirstAlgebra κ)) ⊔
      Erdos1172CohenIteration.bitValue (ErdosOmegaTwo.omegaOne : bSet (FirstAlgebra κ))
        (check ((PSet.ordinalMk κ.ord).Func i)) (1 : bSet (FirstAlgebra κ)) = ⊤ :=
  Erdos1172CohenIteration.bitValue_zero_sup_one_eq_top
    ErdosOmegaTwo.omegaOne_property (firstStage_coordinate_mem κ Hκ Hunc i)

theorem anonymousSubset_subset (κ : Cardinal.{u}) :
    (⊤ : anonymousAlgebra κ) ≤ anonymousSubset κ ⊆ᴮ check (PSet.ordinalMk κ.ord) :=
  Erdos1172CohenIteration.generatedName_subset (PSet.ordinalMk κ.ord)

theorem anonymousSubset_recovers (κ : Cardinal.{u}) :
    (⊤ : Algebra κ) ≤ cohenSubset κ =ᴮ
      ErdosNameTransport.mapNames (inclusion (anonymousAlgebra κ)) (anonymousSubset κ) :=
  Erdos1172CohenIteration.generatedName_recovers (PSet.ordinalMk κ.ord)

theorem anonymousAlgebra_le_iff (κ : Cardinal.{u})
    (S : CompleteSubalgebra (Algebra κ)) :
    anonymousAlgebra κ ≤ S ↔
      ∀ i : (PSet.ordinalMk κ.ord).Type,
        Erdos1172CohenIteration.bitValue (ErdosOmegaTwo.omegaOne : bSet (FirstAlgebra κ))
          (check ((PSet.ordinalMk κ.ord).Func i)) (1 : bSet (FirstAlgebra κ)) ∈ S :=
  Erdos1172CohenIteration.generatedAlgebra_le_iff_bitValues (PSet.ordinalMk_inj κ.ord) S

theorem bitValue_mem_anonymousAlgebra (κ : Cardinal.{u})
    (i : (PSet.ordinalMk κ.ord).Type) :
    Erdos1172CohenIteration.bitValue (ErdosOmegaTwo.omegaOne : bSet (FirstAlgebra κ))
      (check ((PSet.ordinalMk κ.ord).Func i)) (1 : bSet (FirstAlgebra κ)) ∈
        anonymousAlgebra κ :=
  Erdos1172CohenIteration.bitValue_mem_generatedAlgebra (PSet.ordinalMk_inj κ.ord) i

end Erdos1172LevyCohen
