module

public import Erdos1172.Part3NeighborhoodIdealCore
public import Erdos1172.Part3BHTFiniteCommonBlueColumns

@[expose] public section

open Cardinal Ordinal Set Order

namespace Erdos1172Part3RedCoreIdeal

open Erdos1172Part3NeighborhoodCode Erdos1172Part3NeighborhoodIdeal
  Erdos1172Part3FiniteIdealEndpoint

def HasCore (G : SimpleGraph W2) (δ : Ordinal) (s : Set W2) : Prop :=
  ∃ c ⊆ s, G.IsClique c ∧ typeLT c = δ

theorem HasCore.mono {G : SimpleGraph W2} {δ : Ordinal} {s t : Set W2}
    (h : HasCore G δ s) (hst : s ⊆ t) : HasCore G δ t := by
  obtain ⟨c, hc, hcl, hct⟩ := h
  exact ⟨c, hc.trans hst, hcl, hct⟩

theorem no_core_union (G : SimpleGraph W2) (e : Ordinal) {s t : Set W2}
    (hs : ¬HasCore G (ω ^ e) s) (ht : ¬HasCore G (ω ^ e) t) :
    ¬HasCore G (ω ^ e) (s ∪ t) := by
  rintro ⟨c, hc, hcl, hct⟩
  have hcs : typeLT (c ∩ s : Set W2) < ω ^ e := by
    by_contra h
    obtain ⟨d, hd, hdt⟩ := Ordinal.exists_subset_typeLT_eq (c ∩ s)
      (le_of_not_gt h)
    exact hs ⟨d, hd.trans Set.inter_subset_right,
      hcl.subset (hd.trans Set.inter_subset_left), hdt⟩
  have hct' : typeLT (c ∩ t : Set W2) < ω ^ e := by
    by_contra h
    obtain ⟨d, hd, hdt⟩ := Ordinal.exists_subset_typeLT_eq (c ∩ t)
      (le_of_not_gt h)
    exact ht ⟨d, hd.trans Set.inter_subset_right,
      hcl.subset (hd.trans Set.inter_subset_left), hdt⟩
  have hsmall := Erdos1172Part3BHTFiniteCommonBlueColumns.typeLT_union_lt_opow hcs hct'
  have hsub : c ⊆ (c ∩ s) ∪ (c ∩ t) := by
    intro x hx
    rcases hc hx with hxs | hxt
    · exact Or.inl ⟨hx, hxs⟩
    · exact Or.inr ⟨hx, hxt⟩
  have h := (Ordinal.type_mono hsub).trans_lt hsmall
  rw [hct] at h
  exact h.false

/-- The finite ideal generated by local neighborhood-small sets and sets
without a red core. Its countable completeness is NOT asserted. -/
def RedSmall (r : Code ↪ W2) (G H : SimpleGraph W2) (δ : Ordinal)
    (a : W2) (s : Set W2) : Prop :=
  ∃ z : Set W2, Small r G H a z ∧ ¬HasCore G δ (s \ z)

variable {r : Code ↪ W2} {G H : SimpleGraph W2} {δ : Ordinal} {a : W2}

theorem redSmall_mono {s t : Set W2} (hst : s ⊆ t)
    (ht : RedSmall r G H δ a t) : RedSmall r G H δ a s := by
  obtain ⟨z, hz, hzt⟩ := ht
  exact ⟨z, hz, fun hs => hzt (hs.mono (fun _ hx => ⟨hst hx.1, hx.2⟩))⟩

theorem no_core_empty (hδ : 0 < δ) : ¬HasCore G δ ∅ := by
  rintro ⟨c, hc, _, hct⟩
  have he : c = ∅ := Set.eq_empty_of_subset_empty hc
  subst c
  have hz : typeLT (∅ : Set W2) = 0 := Ordinal.type_eq_zero_of_empty (· < ·)
  exact hδ.ne (hz.symm.trans hct)

theorem base_le_red (hδ : 0 < δ) {s : Set W2} (hs : Small r G H a s) :
    RedSmall r G H δ a s :=
  ⟨s, hs, by simpa only [Set.sdiff_self] using no_core_empty (G := G) hδ⟩

theorem redSmall_union (ha : GoodCut r G H a) (e : Ordinal) {s t : Set W2}
    (hs : RedSmall r G H (ω ^ e) a s) (ht : RedSmall r G H (ω ^ e) a t) :
    RedSmall r G H (ω ^ e) a (s ∪ t) := by
  obtain ⟨z, hz, hzs⟩ := hs
  obtain ⟨w, hw, hwt⟩ := ht
  refine ⟨z ∪ w, union_small ha hz hw, ?_⟩
  intro hcore
  apply no_core_union G e hzs hwt
  apply hcore.mono
  intro x hx
  rcases hx.1 with hxs | hxt
  · exact Or.inl ⟨hxs, fun hxz => hx.2 (Or.inl hxz)⟩
  · exact Or.inr ⟨hxt, fun hxw => hx.2 (Or.inr hxw)⟩

def redSmallness (ha : GoodCut r G H a) (e : Ordinal) : FiniteSmallness W2 where
  small := RedSmall r G H (ω ^ e) a
  empty_small := base_le_red (Ordinal.opow_pos e Ordinal.omega0_pos) (empty_small ha)
  mono := redSmall_mono
  union_small := redSmall_union ha e

theorem core_of_red_positive (ha : GoodCut r G H a) {s : Set W2}
    (hs : ¬RedSmall r G H δ a s) : HasCore G δ s := by
  by_contra h
  exact hs ⟨∅, empty_small ha, by simpa only [Set.sdiff_empty] using h⟩

theorem mk_eq_alephTwo_of_isCofinal {s : Set W2} (hs : IsCofinal s) :
    #s = ℵ_ 2 := by
  apply le_antisymm
  · simpa only [W2, Cardinal.mk_toType, Ordinal.card_omega] using Cardinal.mk_set_le s
  · simpa only [cof_W2] using Order.cof_le hs

/-- A fixed trace is red-core-positive on a club, provided every
source-sized set already has a red core. The witness for this reflection
is chosen from each globally coded set; it is not an extra local premise. -/
theorem exists_club_red_positive_trace
    (r : Code ↪ W2) (G H : SimpleGraph W2) (δ : Ordinal)
    (hδ : δ.card < ℵ_ 2)
    (hlarge : ∀ s : Set W2, #s = ℵ_ 2 → HasCore G δ s)
    (source : Set W2) :
    ∃ club : Set W2, IsClub club ∧ ∀ a ∈ club, a ∈ source →
      ¬RedSmall r G H δ a (source ∩ Set.Iio a) := by
  classical
  have hbound (c : Code) : ∃ b : W2, ∀ a : W2, b < a →
      a ∈ source \ eval G H c →
      HasCore G δ ((source ∩ Set.Iio a) \ eval G H c) := by
    let named := source \ eval G H c
    by_cases hcof : IsCofinal named
    · obtain ⟨core, hcore, hclique, htype⟩ := hlarge named
        (mk_eq_alephTwo_of_isCofinal hcof)
      have hcard : #core < Order.cof W2 := by
        have hc : #core = δ.card := by
          simpa only [Ordinal.card_type] using congrArg Ordinal.card htype
        rwa [hc, cof_W2]
      obtain ⟨b, hb⟩ := not_isCofinal_iff.mp
        (fun hc => hcard.not_ge (Order.cof_le hc))
      refine ⟨b, fun a hba _ => ⟨core, ?_, hclique, htype⟩⟩
      intro x hx
      exact ⟨⟨(hcore hx).1, (hb x hx).trans hba⟩, (hcore hx).2⟩
    · obtain ⟨b, hb⟩ := not_isCofinal_iff.mp hcof
      exact ⟨b, fun a hba ha => ((hb a ha).asymm hba).elim⟩
  choose bound hbound using hbound
  let club := {a | ∀ c, r c < a → bound c < a}
  have hclub : IsClub club := ClubClosure.isClub_rankClosed r bound alephZero_lt_cof_W2
  refine ⟨club, hclub, ?_⟩
  intro a ha has hsmall
  obtain ⟨z, ⟨c, hc, hac, hzc⟩, hno⟩ := hsmall
  apply hno
  apply (hbound c a (ha c hc) ⟨has, hac⟩).mono
  intro x hx
  exact ⟨hx.1, fun hxz => hx.2 (hzc hxz)⟩

end Erdos1172Part3RedCoreIdeal
