module

public import Erdos1172.ForMathlib.SetTheory.Cardinal.SmallUnionCode
public import Erdos1172.ForMathlib.SetTheory.Ordinal.ClubClosure
public import Erdos1172.ForMathlib.SetTheory.Ordinal.ErdosRadoGCHAsymmetric

@[expose] public section

/-!
# Global neighborhood codes for Part 2

Under GCH, the neighborhood algebra generated by the two graphs and all
initial intervals has at most `alephThree` well-founded codes. It is closed
under complements and unions of at most `alephOne` sets. This is an actual
construction from the graphs, independent of the endpoint ideal assumptions.
-/

open Cardinal Ordinal Set Function Order

namespace Erdos1172NeighborhoodCode

abbrev W1 : Type := (ω_ 1 : Ordinal.{0}).ToType
abbrev W3 : Type := (ω_ 3 : Ordinal.{0}).ToType
abbrev Atom : Type := Fin 3 × W3
abbrev Code : Type := SmallUnionCode.Code W1 Atom

theorem cof_W3 : Order.cof W3 = ℵ_ 3 := by
  rw [Ordinal.cof_toType]
  have hreg : (ℵ_ 3 : Cardinal.{0}).IsRegular := by
    convert Cardinal.isRegular_aleph_add_one 2 using 1 <;> norm_num
  simpa only [Cardinal.ord_aleph] using hreg.cof_ord

instance : IsRegularCardinalOrder W3 where
  type_lt_le_ord_cof := by rw [cof_W3, Cardinal.ord_aleph, Ordinal.type_toType]

theorem alephZero_lt_cof_W3 : ℵ₀ < Order.cof W3 := by
  rw [cof_W3, ← Cardinal.aleph_zero]
  exact Cardinal.aleph_lt_aleph.mpr (by norm_num)

theorem mk_Atom_le : #Atom ≤ ℵ_ 3 := by
  simp only [Atom, Cardinal.mk_prod, Cardinal.lift_id, Cardinal.mk_fin,
    W3, Cardinal.mk_toType, Ordinal.card_omega]
  calc
    (3 : Cardinal) * ℵ_ 3 ≤ ℵ_ 3 * ℵ_ 3 := mul_le_mul'
      (Cardinal.natCast_le_aleph0.trans (Cardinal.aleph0_le_aleph 3)) le_rfl
    _ = ℵ_ 3 := Cardinal.mul_eq_self (Cardinal.aleph0_le_aleph 3)

theorem mk_Code_le (hGCH : GCH) : #Code ≤ ℵ_ 3 := by
  apply SmallUnionCode.mk_code_le (μ := ℵ_ 1)
    (Cardinal.one_le_aleph0.trans (Cardinal.aleph0_le_aleph 1))
    (Cardinal.aleph0_le_aleph 3)
  · simp only [W1, Cardinal.mk_toType, Ordinal.card_omega, le_refl]
  · exact mk_Atom_le
  · exact hGCH.aleph_three_power_aleph_one.le

/-- A single fixed rank map will be used at every local cut. -/
noncomputable def rank (hGCH : GCH) : Code ↪ W3 :=
  Classical.choice ((Cardinal.le_def Code W3).mp (by
    simpa only [W3, Cardinal.mk_toType, Ordinal.card_omega] using mk_Code_le hGCH))

def atoms (G H : SimpleGraph W3) : Atom → Set W3
  | (0, x) => {y | G.Adj x y}
  | (1, x) => {y | H.Adj x y}
  | (2, x) => Set.Iic x

def eval (G H : SimpleGraph W3) : Code → Set W3 :=
  SmallUnionCode.eval (atoms G H)

def family (G H : SimpleGraph W3) : Set (Set W3) :=
  SmallUnionCode.family (I := W1) (atoms G H)

theorem mk_family_le (hGCH : GCH) (G H : SimpleGraph W3) :
    #(family G H) ≤ ℵ_ 3 := Cardinal.mk_range_le.trans (mk_Code_le hGCH)

theorem mk_le_alephOne_of_lt_alephTwo {J : Type} (hJ : #J < ℵ_ 2) :
    #J ≤ ℵ_ 1 := by
  apply Order.lt_succ_iff.mp
  convert hJ using 1
  rw [Cardinal.succ_aleph]
  norm_num

theorem iUnion_mem_family (G H : SimpleGraph W3) {J : Type}
    (hJ : #J < ℵ_ 2) (s : J → Set W3) (hs : ∀ j, s j ∈ family G H) :
    (⋃ j, s j) ∈ family G H := by
  apply SmallUnionCode.iUnion_mem_family_of_mk_le (atoms G H) _ s hs
  simpa only [W1, Cardinal.mk_toType, Ordinal.card_omega] using
    mk_le_alephOne_of_lt_alephTwo hJ

abbrev LocalCode (r : Code ↪ W3) (a : W3) := {c : Code // r c < a}

theorem mk_LocalCode_le (r : Code ↪ W3) (a : W3) :
    #(LocalCode r a) ≤ ℵ_ 2 := by
  have he : #(LocalCode r a) ≤ #(Set.Iio a) :=
    Cardinal.mk_le_of_injective (f := fun c : LocalCode r a =>
      (⟨r c.val, c.property⟩ : Set.Iio a)) (by
        intro c d h
        exact Subtype.ext (r.injective (congrArg Subtype.val h)))
  apply he.trans
  apply Order.lt_succ_iff.mp
  have hlt := Cardinal.mk_Iio_lt a (Cardinal.ord_cardinalMk (α := W3))
  simpa only [W3, Cardinal.mk_toType, Ordinal.card_omega,
    Cardinal.succ_aleph, show (2 : Ordinal) + 1 = 3 by norm_num] using hlt

/-- All unions of local codes at a fixed bounded stage still occupy only
`alephTwo` ranks. This is the second, local use of GCH. -/
theorem mk_unionRanks_le (hGCH : GCH) (r : Code ↪ W3) (a : W3) :
    #(Set.range (fun c : W1 → LocalCode r a =>
      r (SmallUnionCode.union (fun i => (c i).val)))) ≤ ℵ_ 2 := by
  refine Cardinal.mk_range_le.trans ?_
  rw [Cardinal.mk_arrow]
  simp only [Cardinal.lift_id, W1, Cardinal.mk_toType, Ordinal.card_omega]
  exact (Cardinal.power_le_power_right (mk_LocalCode_le r a)).trans_eq
    hGCH.aleph_two_power_aleph_one

theorem exists_unionBound (hGCH : GCH) (r : Code ↪ W3) (a : W3) :
    ∃ b : W3, ∀ c : W1 → LocalCode r a,
      r (SmallUnionCode.union (fun i => (c i).val)) < b := by
  have hsmall := (mk_unionRanks_le hGCH r a).trans_lt
    (Cardinal.aleph_lt_aleph.mpr (by norm_num : (2 : Ordinal) < 3))
  rw [← cof_W3] at hsmall
  obtain ⟨b, hb⟩ := not_isCofinal_iff.mp
    (fun hc => hsmall.not_ge (Order.cof_le hc))
  exact ⟨b, fun c => hb _ ⟨c, rfl⟩⟩

noncomputable def unionBound (hGCH : GCH) (r : Code ↪ W3) (a : W3) : W3 :=
  (exists_unionBound hGCH r a).choose

theorem unionBound_spec (hGCH : GCH) (r : Code ↪ W3) (a : W3)
    (c : W1 → LocalCode r a) :
    r (SmallUnionCode.union (fun i => (c i).val)) < unionBound hGCH r a :=
  (exists_unionBound hGCH r a).choose_spec c

/-- Small cofinality of the operands, together with closure under the bound
map, gives the infinitary closure at the cut itself. -/
theorem union_rank_lt_of_closedUnder (hGCH : GCH) (r : Code ↪ W3)
    {a : W3} (ha : ErdosRadoGCHAsym.IsOmegaTwoSup a)
    (hclosed : ClubClosure.ClosedUnder (unionBound hGCH r) a)
    (c : W1 → Code) (hc : ∀ i, r (c i) < a) :
    r (SmallUnionCode.union c) < a := by
  obtain ⟨b, hba, hb⟩ :=
    ErdosRadoGCHAsym.exists_strict_bound_of_small_of_IsOmegaTwoSup ha
      (seed := Set.range (fun i => r (c i))) (by
        simpa only [W1, Cardinal.mk_toType, Ordinal.card_omega] using
          (Cardinal.mk_range_le (f := fun i => r (c i)))) (by
        rintro _ ⟨i, rfl⟩
        exact hc i)
  exact (unionBound_spec hGCH r b
    (fun i => ⟨c i, hb _ ⟨i, rfl⟩⟩)).trans (hclosed b hba)

/-- The local closure and reflection properties used to construct the ideal.
All fields are supplied on a stationary set by the following theorem. -/
structure GoodCut (r : Code ↪ W3) (G H : SimpleGraph W3) (a : W3) : Prop where
  isOmegaTwoSup : ErdosRadoGCHAsym.IsOmegaTwoSup a
  empty_lt : r SmallUnionCode.empty < a
  compl_lt : ∀ c, r c < a → r (SmallUnionCode.compl c) < a
  union_lt : ∀ c : W1 → Code, (∀ i, r (c i) < a) →
    r (SmallUnionCode.union c) < a
  atom_lt : ∀ k : Fin 3, ∀ x < a, r (SmallUnionCode.atom (k, x)) < a
  reflects_univ : ∀ c, r c < a → Set.Iio a ⊆ eval G H c →
    Set.univ ⊆ eval G H c

/-- GCH constructs the local closure data on a club restricted to points
of cofinality `omegaTwo`; they are not additional hypotheses on the coloring. -/
theorem exists_club_goodCut (hGCH : GCH) (r : Code ↪ W3)
    (G H : SimpleGraph W3) :
    ∃ club : Set W3, IsClub club ∧ ∀ a ∈ club,
      ErdosRadoGCHAsym.IsOmegaTwoSup a → GoodCut r G H a := by
  let ca : Set W3 := ⋂ k : Fin 3,
    {a | ClubClosure.ClosedUnder (fun x => r (SmallUnionCode.atom (k, x))) a}
  have hca : IsClub ca := IsClub.iInter_of_countable alephZero_lt_cof_W3.ne'
    (fun k => ClubClosure.isClub_closedUnder
      (fun x => r (SmallUnionCode.atom (k, x))) alephZero_lt_cof_W3)
  let cc : Set W3 := {a | ∀ c, r c < a → r (SmallUnionCode.compl c) < a}
  have hcc : IsClub cc := ClubClosure.isClub_rankClosed r
    (fun c => r (SmallUnionCode.compl c)) alephZero_lt_cof_W3
  let cu : Set W3 := {a | ClubClosure.ClosedUnder (unionBound hGCH r) a}
  have hcu : IsClub cu := ClubClosure.isClub_closedUnder
    (unionBound hGCH r) alephZero_lt_cof_W3
  let ce : Set W3 :=
    {a | ClubClosure.ClosedUnder (fun _ => r SmallUnionCode.empty) a}
  have hce : IsClub ce := ClubClosure.isClub_closedUnder
    (fun _ => r SmallUnionCode.empty) alephZero_lt_cof_W3
  obtain ⟨cr, hcr, hr⟩ := ClubClosure.exists_club_reflects r (eval G H)
    Set.univ alephZero_lt_cof_W3
  refine ⟨(((ca ∩ cc) ∩ cu) ∩ ce) ∩ cr,
    (((hca.inter alephZero_lt_cof_W3.ne' hcc).inter
      alephZero_lt_cof_W3.ne' hcu).inter alephZero_lt_cof_W3.ne' hce).inter
      alephZero_lt_cof_W3.ne' hcr, ?_⟩
  rintro a ⟨⟨⟨⟨ha, hc⟩, hu⟩, he⟩, hr'⟩ hsup
  refine ⟨hsup, ?_, hc, union_rank_lt_of_closedUnder hGCH r hsup hu, ?_, ?_⟩
  · obtain ⟨b, hba, _⟩ :=
      ErdosRadoGCHAsym.exists_strict_bound_of_small_of_IsOmegaTwoSup hsup
        (seed := ∅) (by simp) (by simp)
    exact he b hba
  · intro k x hx
    exact (Set.mem_iInter.mp ha k) x hx
  · intro c hc hsub
    exact hr a hr' c hc (by simpa only [Set.univ_inter] using hsub)

theorem isStationary_goodCut (hGCH : GCH) (r : Code ↪ W3)
    (G H : SimpleGraph W3) : IsStationary {a | GoodCut r G H a} := by
  obtain ⟨club, hclub, hgood⟩ := exists_club_goodCut hGCH r G H
  intro test htest
  obtain ⟨a, hsup, ha, hatest⟩ :=
    ErdosRadoGCHAsym.isStationary_isOmegaTwoSup_omegaThree
      (hclub.inter alephZero_lt_cof_W3.ne' htest)
  exact ⟨a, hgood a ha hsup, hatest⟩

end Erdos1172NeighborhoodCode
